SELECT merge(temp) FROM (VALUES
  (tquadbin '480fffffffffffff@2001-01-01'),
  (tquadbin '48427fffffffffff@2001-01-02')) t(temp);
                                             merge                                              
------------------------------------------------------------------------------------------------
 {480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT merge(temp) FROM (VALUES
  (tquadbin '480fffffffffffff@2001-01-01'),
  (tquadbin '48427fffffffffff@2001-01-02')) t(temp);
                                             merge                                              
------------------------------------------------------------------------------------------------
 {480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

