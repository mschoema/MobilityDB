(1 row)

SELECT ST_SRID(cellToBoundary(quadbin '48a6227affffffff'));
 st_srid 
---------
    4326
(1 row)

-- The centroid point lies inside the cell boundary polygon
SELECT ST_Contains(
  cellToBoundary(quadbin '48a6227affffffff'),
  cellToPoint(quadbin '48a6227affffffff'));
 st_contains 
-------------
 t
(1 row)

