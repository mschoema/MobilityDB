SELECT round(cellArea(quadbin '480fffffffffffff')::numeric, 1);
       round       
-------------------
 508164135963886.0
(1 row)

-- A finer cell has strictly smaller area than a coarser one
SELECT cellArea(quadbin '48a6227affffffff')
  < cellArea(quadbin '48427fffffffffff');
 ?column? 
