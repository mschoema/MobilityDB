-------------------------------------------------------------------------------
-- quadbinset type: parser/output, WKB helpers, constructors, accessors,
-- comparison operators, btree/hash opclasses, unnest, setUnion aggregate.
-------------------------------------------------------------------------------
-- Input/output
-------------------------------------------------------------------------------
SELECT quadbinset '{480fffffffffffff, 48427fffffffffff}';
                quadbinset                
------------------------------------------
 {"480fffffffffffff", "48427fffffffffff"}
(1 row)

SELECT quadbinset '{48427fffffffffff, 480fffffffffffff}';  -- normalized + sorted
                quadbinset                
------------------------------------------
 {"480fffffffffffff", "48427fffffffffff"}
(1 row)

-- Singleton
SELECT quadbinset '{480fffffffffffff}';
      quadbinset      
----------------------
 {"480fffffffffffff"}
(1 row)

/* Errors */
SELECT quadbinset '{480fffffffffffff, not-a-cell}';
ERROR:  quadbin value "not-a-cell" does not encode a valid quadbin index
LINE 2: SELECT quadbinset '{480fffffffffffff, not-a-cell}';
                          ^
SELECT quadbinset '{480fffffffffffff';
ERROR:  Could not parse quadbinset value: Missing closing brace
LINE 1: SELECT quadbinset '{480fffffffffffff';
                          ^
-------------------------------------------------------------------------------
-- Constructors
-------------------------------------------------------------------------------
SELECT set(ARRAY[quadbin '480fffffffffffff', quadbin '48427fffffffffff']);
                   set                    
------------------------------------------
 {"480fffffffffffff", "48427fffffffffff"}
(1 row)

SELECT set(quadbin '480fffffffffffff');
         set          
----------------------
 {"480fffffffffffff"}
(1 row)

SELECT (quadbin '480fffffffffffff')::quadbinset;
      quadbinset      
----------------------
 {"480fffffffffffff"}
(1 row)

-------------------------------------------------------------------------------
-- Accessors
-------------------------------------------------------------------------------
SELECT numValues(quadbinset '{480fffffffffffff, 48427fffffffffff, 48a6227affffffff}');
 numvalues 
-----------
         3
(1 row)

SELECT startValue(quadbinset '{480fffffffffffff, 48427fffffffffff}');
    startvalue    
------------------
 480fffffffffffff
(1 row)

SELECT endValue(quadbinset '{480fffffffffffff, 48427fffffffffff}');
     endvalue     
------------------
 48427fffffffffff
(1 row)

SELECT valueN(quadbinset '{480fffffffffffff, 48427fffffffffff}', 1);
      valuen      
------------------
 480fffffffffffff
(1 row)

SELECT valueN(quadbinset '{480fffffffffffff, 48427fffffffffff}', 2);
      valuen      
------------------
 48427fffffffffff
(1 row)

SELECT getValues(quadbinset '{480fffffffffffff, 48427fffffffffff}');
              getvalues              
-------------------------------------
 {480fffffffffffff,48427fffffffffff}
(1 row)

SELECT memSize(quadbinset '{480fffffffffffff, 48427fffffffffff}') > 0;
 ?column? 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- WKB / HexWKB round-trip
-------------------------------------------------------------------------------
SELECT quadbinsetFromBinary(asBinary(quadbinset '{480fffffffffffff, 48427fffffffffff}'))
  = quadbinset '{480fffffffffffff, 48427fffffffffff}';
 ?column? 
----------
 t
(1 row)

SELECT quadbinsetFromHexWKB(asHexWKB(quadbinset '{480fffffffffffff, 48427fffffffffff}'))
  = quadbinset '{480fffffffffffff, 48427fffffffffff}';
 ?column? 
----------
 t
(1 row)

SELECT asText(quadbinset '{480fffffffffffff, 48427fffffffffff}');
                  astext                  
------------------------------------------
 {"480fffffffffffff", "48427fffffffffff"}
(1 row)

-- EWKT, EWKB and HexEWKB state the SRID 4326 of a cell, and every form reads back
SELECT asEWKT(quadbinset '{480fffffffffffff, 48427fffffffffff}');
                       asewkt                       
----------------------------------------------------
 SRID=4326;{"480fffffffffffff", "48427fffffffffff"}
(1 row)

SELECT asHexEWKB(quadbinset '{480fffffffffffff}', 'XDR');
                ashexewkb                 
------------------------------------------
 00004841000010E600000001480FFFFFFFFFFFFF
(1 row)

SELECT quadbinsetFromText(asText(quadbinset '{480fffffffffffff, 48427fffffffffff}'))
  = quadbinset '{480fffffffffffff, 48427fffffffffff}';
 ?column? 
----------
 t
(1 row)

SELECT quadbinsetFromEWKT(asEWKT(quadbinset '{480fffffffffffff, 48427fffffffffff}'))
  = quadbinset '{480fffffffffffff, 48427fffffffffff}';
 ?column? 
----------
 t
(1 row)

SELECT quadbinsetFromEWKB(asEWKB(quadbinset '{480fffffffffffff, 48427fffffffffff}'))
  = quadbinset '{480fffffffffffff, 48427fffffffffff}';
 ?column? 
----------
 t
(1 row)

SELECT quadbinsetFromHexEWKB(asHexEWKB(quadbinset '{480fffffffffffff, 48427fffffffffff}'))
  = quadbinset '{480fffffffffffff, 48427fffffffffff}';
 ?column? 
----------
 t
(1 row)

-- A cell states SRID 4326, so another SRID is refused in every input form
SELECT quadbinsetFromEWKT('SRID=3857;{480fffffffffffff}');
ERROR:  The SRID 3857 cannot be stated for the quadbin
SELECT quadbinsetFromHexEWKB(replace(asHexEWKB(quadbinset '{480fffffffffffff}', 'XDR'),
  '000010E6', '00000F11'));
ERROR:  The SRID of the WKB (3857) does not match the SRID of the quadbinset (4326)
