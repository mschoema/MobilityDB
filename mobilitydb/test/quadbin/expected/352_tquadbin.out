-------------------------------------------------------------------------------
-- tquadbin type: input/output, typmod, ASSIGNMENT casts to/from tbigint,
-- comparison operators, btree/hash indexing, binary IO round-trip.
--
-- The basetype is hex-encoded; quadbin '480fffffffffffff' is the z0 world
-- cell, '48427fffffffffff' is tile(3,5,4), '48a6227affffffff' is res 10.
-------------------------------------------------------------------------------
-- Input/output
-------------------------------------------------------------------------------
-- Temporal instant
SELECT tquadbin '480fffffffffffff@2012-01-01 08:00:00';
                   tquadbin                    
-----------------------------------------------
 480fffffffffffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

/* Errors */
SELECT tquadbin 'ABC@2012-01-01 08:00:00';
ERROR:  quadbin value "ABC" does not encode a valid quadbin index
LINE 2: SELECT tquadbin 'ABC@2012-01-01 08:00:00';
                        ^
SELECT tquadbin '480fffffffffffff@2012-01-01 08:00:00,';
ERROR:  Could not parse tquadbin value: Extraneous characters at the end
LINE 1: SELECT tquadbin '480fffffffffffff@2012-01-01 08:00:00,';
                        ^
-------------------------------------------------------------------------------
-- Temporal discrete sequence
SELECT tquadbin ' { 480fffffffffffff@2001-01-01 08:00:00 , 48427fffffffffff@2001-01-01 08:05:00 , 48a6227affffffff@2001-01-01 08:06:00 } ';
                                                                   tquadbin                                                                    
-----------------------------------------------------------------------------------------------------------------------------------------------
 {480fffffffffffff@Mon Jan 01 08:00:00 2001 PST, 48427fffffffffff@Mon Jan 01 08:05:00 2001 PST, 48a6227affffffff@Mon Jan 01 08:06:00 2001 PST}
(1 row)

SELECT tquadbin '{480fffffffffffff@2001-01-01 08:00:00,48427fffffffffff@2001-01-01 08:05:00}';
                                            tquadbin                                            
------------------------------------------------------------------------------------------------
 {480fffffffffffff@Mon Jan 01 08:00:00 2001 PST, 48427fffffffffff@Mon Jan 01 08:05:00 2001 PST}
(1 row)

/* Errors */
SELECT tquadbin '{480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02';
ERROR:  Could not parse tquadbin value: Missing closing brace
LINE 2: SELECT tquadbin '{480fffffffffffff@2001-01-01, 48427ffffffff...
                        ^
-------------------------------------------------------------------------------
-- Temporal continuous sequence (step interpolation inherited from int8)
SELECT tquadbin '[480fffffffffffff@2001-01-01 08:00:00,48427fffffffffff@2001-01-01 08:05:00]';
                                            tquadbin                                            
------------------------------------------------------------------------------------------------
 [480fffffffffffff@Mon Jan 01 08:00:00 2001 PST, 48427fffffffffff@Mon Jan 01 08:05:00 2001 PST]
(1 row)

SELECT tquadbin 'Interp=Step;[480fffffffffffff@2001-01-01 08:00:00,48427fffffffffff@2001-01-01 08:05:00]';
                                            tquadbin                                            
------------------------------------------------------------------------------------------------
 [480fffffffffffff@Mon Jan 01 08:00:00 2001 PST, 48427fffffffffff@Mon Jan 01 08:05:00 2001 PST]
(1 row)

-------------------------------------------------------------------------------
-- Temporal sequence set
SELECT tquadbin '{[480fffffffffffff@2001-01-01 08:00:00,48427fffffffffff@2001-01-01 08:05:00],[48a6227affffffff@2001-01-01 08:10:00]}';
                                                                     tquadbin                                                                      
---------------------------------------------------------------------------------------------------------------------------------------------------
 {[480fffffffffffff@Mon Jan 01 08:00:00 2001 PST, 48427fffffffffff@Mon Jan 01 08:05:00 2001 PST], [48a6227affffffff@Mon Jan 01 08:10:00 2001 PST]}
(1 row)

-------------------------------------------------------------------------------
-- MF-JSON input/output (quadbin cell ids are serialized as their int8 value,
-- mirroring the tbigint sibling)
-------------------------------------------------------------------------------
SELECT asMFJSON(tquadbin '480fffffffffffff@2012-01-01 08:00:00');
                                                                                    asmfjson                                                                                     
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingQuadbin","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"values":["480fffffffffffff"],"datetimes":["2012-01-01T08:00:00-08:00"],"interpolation":"None"}
(1 row)

SELECT asMFJSON(tquadbin '{480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02}');
                                                                                                                               asmfjson                                                                                                                               
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingQuadbin","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"values":["480fffffffffffff","48427fffffffffff"],"datetimes":["2001-01-01T00:00:00-08:00","2001-01-02T00:00:00-08:00"],"lower_inc":true,"upper_inc":true,"interpolation":"Discrete"}
(1 row)

SELECT asMFJSON(tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]');
                                                                                                                             asmfjson                                                                                                                             
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingQuadbin","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"values":["480fffffffffffff","48427fffffffffff"],"datetimes":["2001-01-01T00:00:00-08:00","2001-01-02T00:00:00-08:00"],"lower_inc":true,"upper_inc":true,"interpolation":"Step"}
(1 row)

SELECT asMFJSON(tquadbin '{[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02], [48a6227affffffff@2001-01-03, 48a6227affffffff@2001-01-04]}');
                                                                                                                                                                                                                  asmfjson                                                                                                                                                                                                                   
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingQuadbin","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"sequences":[{"values":["480fffffffffffff","48427fffffffffff"],"datetimes":["2001-01-01T00:00:00-08:00","2001-01-02T00:00:00-08:00"],"lower_inc":true,"upper_inc":true},{"values":["48a6227affffffff","48a6227affffffff"],"datetimes":["2001-01-03T00:00:00-08:00","2001-01-04T00:00:00-08:00"],"lower_inc":true,"upper_inc":true}],"interpolation":"Step"}
(1 row)

-- Bound the bbox precision so the output is platform-independent
SELECT asMFJSON(tquadbin '480fffffffffffff@2012-01-01 08:00:00', 1, 3, 6);
                 asmfjson                  
-------------------------------------------
 {                                        +
   "type": "MovingQuadbin",               +
   "crs": {                               +
     "type": "Name",                      +
     "properties": {                      +
       "name": "EPSG:4326"                +
     }                                    +
   },                                     +
   "bbox": [                              +
     [                                    +
       -180,                              +
       -85.051129                         +
     ],                                   +
     [                                    +
       180,                               +
       85.051129                          +
     ]                                    +
   ],                                     +
   "period": {                            +
     "begin": "2012-01-01T08:00:00-08:00",+
     "end": "2012-01-01T08:00:00-08:00",  +
     "lower_inc": true,                   +
     "upper_inc": true                    +
   },                                     +
   "values": [                            +
     "480fffffffffffff"                   +
   ],                                     +
   "datetimes": [                         +
     "2012-01-01T08:00:00-08:00"          +
   ],                                     +
   "interpolation": "None"                +
 }
(1 row)

-- Round-trip: tquadbinFromMFJSON(asMFJSON(...)) preserves the value
SELECT tquadbinFromMFJSON(asMFJSON(tquadbin '480fffffffffffff@2012-01-01 08:00:00'));
              tquadbinfrommfjson               
-----------------------------------------------
 480fffffffffffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

SELECT tquadbinFromMFJSON(asMFJSON(tquadbin '{480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02}'));
                                       tquadbinfrommfjson                                       
------------------------------------------------------------------------------------------------
 {480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT tquadbinFromMFJSON(asMFJSON(tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]'));
                                       tquadbinfrommfjson                                       
------------------------------------------------------------------------------------------------
 [480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT tquadbinFromMFJSON(asMFJSON(tquadbin '{[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02], [48a6227affffffff@2001-01-03, 48a6227affffffff@2001-01-04]}'));
                                                                                        tquadbinfrommfjson                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST], [48a6227affffffff@Wed Jan 03 00:00:00 2001 PST, 48a6227affffffff@Thu Jan 04 00:00:00 2001 PST]}
(1 row)

-- A cell is written as its text form in a JSON string, and an integer is still
-- read as the cell it encodes; the bounding box is the spatiotemporal box
SELECT asMFJSON(tquadbin '[48a6227affffffff@2001-01-01, 485623ffffffffff@2001-01-02]', 1, 3, 6);
                 asmfjson                  
-------------------------------------------
 {                                        +
   "type": "MovingQuadbin",               +
   "crs": {                               +
     "type": "Name",                      +
     "properties": {                      +
       "name": "EPSG:4326"                +
     }                                    +
   },                                     +
   "bbox": [                              +
     [                                    +
       0,                                 +
       48.922499                          +
     ],                                   +
     [                                    +
       11.25,                             +
       55.776573                          +
     ]                                    +
   ],                                     +
   "period": {                            +
     "begin": "2001-01-01T00:00:00-08:00",+
     "end": "2001-01-02T00:00:00-08:00",  +
     "lower_inc": true,                   +
     "upper_inc": true                    +
   },                                     +
   "values": [                            +
     "48a6227affffffff",                  +
     "485623ffffffffff"                   +
   ],                                     +
   "datetimes": [                         +
     "2001-01-01T00:00:00-08:00",         +
     "2001-01-02T00:00:00-08:00"          +
   ],                                     +
   "lower_inc": true,                     +
   "upper_inc": true,                     +
   "interpolation": "Step"                +
 }
(1 row)

SELECT tquadbinFromMFJSON(replace(asMFJSON(tquadbin '48a6227affffffff@2001-01-01'),
  '"48a6227affffffff"', '5234909528541102079'));
              tquadbinfrommfjson               
-----------------------------------------------
 48a6227affffffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

