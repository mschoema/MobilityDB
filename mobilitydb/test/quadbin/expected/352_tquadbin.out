-- WKB / HexWKB round-trips
-------------------------------------------------------------------------------
SELECT asText(tquadbinFromBinary(asBinary(tquadbin '480fffffffffffff@2001-01-01')));
                    astext                     
-----------------------------------------------
 480fffffffffffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asText(tquadbinFromBinary(asBinary(tquadbin '{480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02}')));
                                             astext                                             
------------------------------------------------------------------------------------------------
 {480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT asText(tquadbinFromBinary(asBinary(tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]')));
                                             astext                                             
------------------------------------------------------------------------------------------------
 [480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asText(tquadbinFromBinary(asBinary(tquadbin '{[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02], [48a6227affffffff@2001-01-03, 48a6227affffffff@2001-01-04]}')));
                                                                                              astext                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST], [48a6227affffffff@Wed Jan 03 00:00:00 2001 PST, 48a6227affffffff@Thu Jan 04 00:00:00 2001 PST]}
(1 row)

-- Little-endian (NDR)
SELECT asText(tquadbinFromBinary(asBinary(tquadbin '480fffffffffffff@2001-01-01', 'NDR')));
                    astext                     
-----------------------------------------------
 480fffffffffffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asText(tquadbinFromHexWKB(asHexWKB(tquadbin '480fffffffffffff@2001-01-01')));
                    astext                     
-----------------------------------------------
 480fffffffffffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

-------------------------------------------------------------------------------
-- Extended forms
-- A cell states SRID 4326, so the extended forms state it and a stated SRID
-- is refused unless it is that one
-------------------------------------------------------------------------------
SELECT asEWKT(tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]');
                                                  asewkt                                                  
----------------------------------------------------------------------------------------------------------
 SRID=4326;[480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asText(tquadbinFromText(asText(tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]')));
                                             astext                                             
------------------------------------------------------------------------------------------------
 [480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asEWKT(tquadbinFromEWKT(asEWKT(tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]')));
                                                  asewkt                                                  
----------------------------------------------------------------------------------------------------------
 SRID=4326;[480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asEWKT(asEWKT(tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]')::tquadbin);
                                                  asewkt                                                  
----------------------------------------------------------------------------------------------------------
 SRID=4326;[480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asEWKT(tquadbinFromEWKB(asEWKB(tquadbin '{480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02}')));
                                                  asewkt                                                  
----------------------------------------------------------------------------------------------------------
 SRID=4326;{480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT asEWKT(tquadbinFromEWKB(asEWKB(tquadbin '480fffffffffffff@2001-01-01', 'NDR')));
                         asewkt                          
---------------------------------------------------------
 SRID=4326;480fffffffffffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asEWKT(tquadbinFromHexEWKB(asHexEWKB(tquadbin '{[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02], [48a6227affffffff@2001-01-03, 48a6227affffffff@2001-01-04]}')));
                                                                                                   asewkt                                                                                                   
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 SRID=4326;{[480fffffffffffff@Mon Jan 01 00:00:00 2001 PST, 48427fffffffffff@Tue Jan 02 00:00:00 2001 PST], [48a6227affffffff@Wed Jan 03 00:00:00 2001 PST, 48a6227affffffff@Thu Jan 04 00:00:00 2001 PST]}
(1 row)

SELECT asEWKT(tquadbinFromEWKT('SRID=4326;480fffffffffffff@2001-01-01'));
                         asewkt                          
---------------------------------------------------------
 SRID=4326;480fffffffffffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

-- The extended binary form states SRID 4326
SELECT asHexEWKB(tquadbin '480fffffffffffff@2001-01-01', 'XDR') LIKE '%000010E6%';
 ?column? 
----------
 t
(1 row)

-- Another SRID is refused, in text and in binary
SELECT tquadbinFromEWKT('SRID=3857;480fffffffffffff@2001-01-01');
ERROR:  The SRID of the quadbin (4326) does not match the SRID of the tquadbin (3857)
SELECT tquadbinFromHexEWKB(replace(asHexEWKB(tquadbin '480fffffffffffff@2001-01-01', 'XDR'), '000010E6', '00000F11'));
ERROR:  The SRID of the WKB (3857) does not match the SRID of the tquadbin (4326)
-------------------------------------------------------------------------------
-- Assignment casts to/from tbigint (explicit AS ASSIGNMENT, bidirectional)
-------------------------------------------------------------------------------
SELECT (tquadbin '480fffffffffffff@2012-01-01 08:00:00')::tbigint;
                     tbigint                      
--------------------------------------------------
 5192650370358181887@Sun Jan 01 08:00:00 2012 PST
(1 row)

SELECT (tbigint '5192650370358181887@2012-01-01 08:00:00')::tquadbin;
                   tquadbin                    
-----------------------------------------------
 480fffffffffffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

-- Not every integer is a cell: an integer encoding no QUADBIN cell is refused
-- by the cast, and in MF-JSON and WKB input, as in text input
/* Errors */
SELECT (tbigint '[5192650370358181887@2001-01-01, 42@2001-01-02]')::tquadbin;
ERROR:  The value 42 does not encode a valid quadbin index
SELECT tquadbinFromMFJSON(replace(asMFJSON(tquadbin '480fffffffffffff@2001-01-01'),
  '"480fffffffffffff"', '42'));
ERROR:  The value 42 does not encode a valid quadbin index
SELECT tquadbinFromMFJSON(replace(asMFJSON(tquadbin '480fffffffffffff@2001-01-01'),
  '"480fffffffffffff"', '"2a"'));
ERROR:  quadbin value "2a" does not encode a valid quadbin index
SELECT tquadbinFromHexWKB(replace(asHexWKB(tquadbin '480fffffffffffff@2001-01-01',
  'XDR'), '480FFFFFFFFFFFFF', '000000000000002A'));
ERROR:  The value 42 does not encode a valid quadbin index
SELECT quadbinsetFromHexWKB(replace(asHexWKB(quadbinset '{480fffffffffffff}',
  'XDR'), '480FFFFFFFFFFFFF', '000000000000002A'));
ERROR:  The value 42 does not encode a valid quadbin index
-- Round-trip preserves value
SELECT ((tquadbin '480fffffffffffff@2012-01-01 08:00:00')::tbigint)::tquadbin
  = tquadbin '480fffffffffffff@2012-01-01 08:00:00';
 ?column? 
----------
 t
(1 row)

-- Assignment-context: cast accepted in INSERT without ::
DROP TABLE IF EXISTS tbl_tquadbin_assign;
NOTICE:  table "tbl_tquadbin_assign" does not exist, skipping
CREATE TABLE tbl_tquadbin_assign(k int, temp tquadbin);
INSERT INTO tbl_tquadbin_assign VALUES (1, tbigint '5192650370358181887@2012-01-01 08:00:00');
SELECT * FROM tbl_tquadbin_assign;
 k |                     temp                      
---+-----------------------------------------------
 1 | 480fffffffffffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

DROP TABLE tbl_tquadbin_assign;
-- The cast is NOT implicit
/* Errors */
\set VERBOSITY terse
SELECT tbigint '5192650370358181887@2012-01-01 08:00:00' = tquadbin '480fffffffffffff@2012-01-01 08:00:00';
ERROR:  operator does not exist: tbigint = tquadbin at character 71
\set VERBOSITY default
-------------------------------------------------------------------------------
-- Comparison operators + btree/hash
-------------------------------------------------------------------------------
SELECT tquadbin '480fffffffffffff@2012-01-01' = tquadbin '480fffffffffffff@2012-01-01';
 ?column? 
----------
 t
(1 row)

SELECT tquadbin '480fffffffffffff@2012-01-01' <> tquadbin '48427fffffffffff@2012-01-01';
 ?column? 
----------
 t
(1 row)

SELECT cmp(tquadbin '480fffffffffffff@2012-01-01', tquadbin '480fffffffffffff@2012-01-01');
 cmp 
-----
   0
(1 row)

-------------------------------------------------------------------------------
-- Send/receive (binary IO round-trip)
-------------------------------------------------------------------------------
DROP TABLE IF EXISTS tbl_tquadbin_binio;
NOTICE:  table "tbl_tquadbin_binio" does not exist, skipping
CREATE TABLE tbl_tquadbin_binio(k int, temp tquadbin);
INSERT INTO tbl_tquadbin_binio VALUES
  (1, tquadbin '480fffffffffffff@2012-01-01 08:00:00'),
  (2, tquadbin '{480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02}'),
  (3, tquadbin '[480fffffffffffff@2001-01-01, 48427fffffffffff@2001-01-02]');
\copy tbl_tquadbin_binio TO 'tbl_tquadbin_binio' (FORMAT BINARY);
DROP TABLE IF EXISTS tbl_tquadbin_binio_tmp;
NOTICE:  table "tbl_tquadbin_binio_tmp" does not exist, skipping
CREATE TABLE tbl_tquadbin_binio_tmp AS TABLE tbl_tquadbin_binio WITH NO DATA;
\copy tbl_tquadbin_binio_tmp FROM 'tbl_tquadbin_binio' (FORMAT BINARY);
SELECT COUNT(*) FROM tbl_tquadbin_binio t1, tbl_tquadbin_binio_tmp t2
  WHERE t1.k = t2.k AND t1.temp <> t2.temp;
 count 
-------
     0
(1 row)

DROP TABLE tbl_tquadbin_binio;
DROP TABLE tbl_tquadbin_binio_tmp;
