      getvalues       
----------------------
 {"47c3c3", "54b5c9"}
(1 row)

SELECT numInstants(ts2cell '[47c3c3@2001-01-01, 54b5c9@2001-01-02]');
 numinstants 
-------------
           2
(1 row)

