-- Accessors
-------------------------------------------------------------------------------
SELECT SUM(numValues(s)) FROM tbl_s2cellset;
 sum 
-----
 477
(1 row)

SELECT COUNT(*) FROM tbl_s2cellset WHERE memSize(s) IS NOT NULL;
 count 
-------
    90
(1 row)

