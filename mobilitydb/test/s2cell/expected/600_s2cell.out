-------------------------------------------------------------------------------
-- Static s2cell SQL type: parser, output, comparison operators, btree +
-- hash opclasses, ASSIGNMENT casts to/from bigint, validity predicates.
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Input and output
--
-- The parser accepts the 16-digit hexadecimal identifier, and the output
-- function answers S2's canonical TOKEN, which is that identifier with its
-- trailing zeros stripped, so the two spellings below denote one cell and the
-- text form round-trips. A literal that encodes no cell is refused rather than
-- stored.
-------------------------------------------------------------------------------
SELECT s2cell '47c3c444c0000000';
  s2cell   
-----------
 47c3c444c
(1 row)

SELECT s2cell '47c3c444c';
  s2cell   
-----------
 47c3c444c
(1 row)

SELECT s2cell '1';
 s2cell 
--------
 1
(1 row)

SELECT s2cell '0';
ERROR:  s2cell value "0" does not encode a valid S2 cell
LINE 1: SELECT s2cell '0';
                      ^
SELECT s2cell 'zzz';
ERROR:  The S2 token "zzz" holds the non-hexadecimal character 'z'
LINE 1: SELECT s2cell 'zzz';
                      ^
SELECT s2cell '47c3c444c0000000' = s2cell '47c3c444c0000000';
 ?column? 
----------
 t
(1 row)

-- the token and the full identifier are the same cell, so the text form of a
-- cell parses back to that cell
SELECT s2cell '47c3c444c' = s2cell '47c3c444c0000000';
 ?column? 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- Casts to and from bigint
--
-- The two share one representation and the cast carries no function, so the
-- round trip is the identity, and it is explicit in both directions.
-------------------------------------------------------------------------------
SELECT (s2cell '47c3c444c0000000')::bigint;
        int8         
---------------------
 5171192596709507072
(1 row)

SELECT ((s2cell '47c3c444c0000000')::bigint)::s2cell = s2cell '47c3c444c0000000';
 ?column? 
----------
 t
(1 row)

-- Not every integer is a cell: the cast into s2cell checks the value, as the
-- text input does, explicitly and in an assignment
/* Errors */
SELECT 42::bigint::s2cell;
ERROR:  The value 42 does not encode a valid s2cell
CREATE TEMP TABLE tbl_s2cell_assign(cell s2cell);
INSERT INTO tbl_s2cell_assign VALUES (42::bigint);
ERROR:  The value 42 does not encode a valid s2cell
DROP TABLE tbl_s2cell_assign;
-------------------------------------------------------------------------------
-- (Hex)WKB round trip
--
-- The base WKB carries no SRID: the WGS84 (4326) the grid fixes is implied,
-- as for an h3index. An EWKB stating 4326 is read, one stating another SRID
-- is refused, and so is an integer that encodes no cell.
-------------------------------------------------------------------------------
SELECT asBinary(s2cell '47c3c444c');
        asbinary        
------------------------
 \x0100000000c044c4c347
(1 row)

SELECT asBinary(s2cell '47c3c444c', 'XDR');
        asbinary        
------------------------
 \x000047c3c444c0000000
(1 row)

SELECT asHexWKB(s2cell '47c3c444c');
       ashexwkb       
----------------------
 0100000000C044C4C347
(1 row)

SELECT asHexWKB(s2cell '47c3c444c', 'XDR');
       ashexwkb       
----------------------
 000047C3C444C0000000
(1 row)

SELECT s2cellFromBinary(asBinary(s2cell '47c3c444c')) = s2cell '47c3c444c';
 ?column? 
----------
 t
(1 row)

SELECT s2cellFromBinary(asBinary(s2cell '54b5c9', 'XDR')) = s2cell '54b5c9';
 ?column? 
----------
 t
(1 row)

SELECT s2cellFromHexWKB(asHexWKB(s2cell '47c3c444c')) = s2cell '47c3c444c';
 ?column? 
----------
 t
(1 row)

SELECT s2cellFromHexWKB(asHexWKB(s2cell '54b5c9', 'XDR')) = s2cell '54b5c9';
 ?column? 
----------
 t
(1 row)

SELECT s2cellFromHexWKB('0140E61000000000000000C9B554');
 s2cellfromhexwkb 
------------------
 54b5c9
(1 row)

/* Errors */
SELECT s2cellFromHexWKB('0140110F00000000000000C9B554');
ERROR:  Only SRID 4326 (WGS84) is accepted for the type s2cell, received 3857
SELECT s2cellFromHexWKB('01000000000000000000');
ERROR:  The value 0 does not encode a valid s2cell
-------------------------------------------------------------------------------
-- Text round trip
-------------------------------------------------------------------------------
SELECT asText(s2cell '47c3c444c');
  astext   
-----------
 47c3c444c
(1 row)

SELECT s2cellFromText(asText(s2cell '47c3c444c')) = s2cell '47c3c444c';
 ?column? 
----------
 t
(1 row)

SELECT s2cellFromText('54b5c9') = s2cell '54b5c9';
 ?column? 
----------
 t
(1 row)

/* Errors */
SELECT s2cellFromText('47c3cxyz');
ERROR:  The S2 token "47c3cxyz" holds the non-hexadecimal character 'x'
-------------------------------------------------------------------------------
-- Comparison operators
--
-- The order is the order of the identifier, which follows the Hilbert curve.
-------------------------------------------------------------------------------
SELECT s2cell '47c3c444c0000000' < s2cell '47c3c444c0000004';
 ?column? 
----------
 t
(1 row)

SELECT s2cell '47c3c444c0000000' <= s2cell '47c3c444c0000000';
 ?column? 
----------
 t
(1 row)

SELECT s2cell '47c3c444c0000004' > s2cell '47c3c444c0000000';
 ?column? 
----------
 t
(1 row)

SELECT s2cell '47c3c444c0000000' <> s2cell '47c3c444c0000004';
 ?column? 
----------
 t
(1 row)

SELECT cmp(s2cell '47c3c444c0000000', s2cell '47c3c444c0000004');
 cmp 
-----
  -1
(1 row)

SELECT cmp(s2cell '47c3c444c0000000', s2cell '47c3c444c0000000');
 cmp 
-----
   0
(1 row)

-------------------------------------------------------------------------------
-- Hash
--
-- Equal cells hash equally, and the seeded form answers a 64-bit value.
-------------------------------------------------------------------------------
SELECT hash(s2cell '47c3c444c0000000') = hash(s2cell '47c3c444c0000000');
 ?column? 
----------
 t
(1 row)

SELECT hash(s2cell '47c3c444c0000000') = hash(s2cell '47c3c444c0000004');
 ?column? 
----------
 f
(1 row)

SELECT hashExtended(s2cell '47c3c444c0000000', 1) =
  hashExtended(s2cell '47c3c444c0000000', 1);
 ?column? 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- Validity
-------------------------------------------------------------------------------
SELECT isValidCell(s2cell '47c3c444c0000000');
 isvalidcell 
-------------
 t
(1 row)

SELECT isValidCell(s2cell '1');
 isvalidcell 
-------------
 t
(1 row)

-------------------------------------------------------------------------------
-- Ordering and grouping, which the btree and hash operator classes carry
--
-- No cell family declares a min or a max aggregate over its base type, so what
-- the operator classes answer is DISTINCT, GROUP BY and ORDER BY.
-------------------------------------------------------------------------------
WITH Cells(cell) AS (VALUES
  (s2cell '47c3c444c0000004'), (s2cell '47c3c444c0000000'),
  (s2cell '47c3c444c0000004') )
SELECT count(*), count(DISTINCT cell) FROM Cells;
 count | count 
-------+-------
     3 |     2
(1 row)

WITH Cells(cell) AS (VALUES
  (s2cell '47c3c444c0000004'), (s2cell '47c3c444c0000000'),
  (s2cell '47c3c444c0000004') )
SELECT cell, count(*) FROM Cells GROUP BY cell ORDER BY cell;
       cell       | count 
------------------+-------
 47c3c444c        |     1
 47c3c444c0000004 |     2
(2 rows)

-------------------------------------------------------------------------------
