-------------------------------------------------------------------------------
-- Input/output functions
-------------------------------------------------------------------------------
-- Temporal instant
SELECT th3index '8a2a100d645ffff@2012-01-01 08:00:00';
                   th3index                   
----------------------------------------------
 8a2a100d645ffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

/* Errors */
SELECT th3index 'ABC@2012-01-01 08:00:00';
ERROR:  invalid h3index input "ABC": not a valid H3 cell, directed edge or vertex
LINE 2: SELECT th3index 'ABC@2012-01-01 08:00:00';
                        ^
SELECT th3index '8a2a100d645ffff@2012-01-01 08:00:00,';
ERROR:  Could not parse th3index value: Extraneous characters at the end
LINE 1: SELECT th3index '8a2a100d645ffff@2012-01-01 08:00:00,';
                        ^
SELECT th3index 'ffffffffffffffffff@2012-01-01 08:00:00';
ERROR:  invalid h3index input "ffffffffffffffffff": at most 16 hexadecimal digits are allowed
LINE 1: SELECT th3index 'ffffffffffffffffff@2012-01-01 08:00:00';
                        ^
SELECT th3index '8a2a100d645fffZZ@2012-01-01 08:00:00';
ERROR:  invalid h3index input "8a2a100d645fffZZ": expected hexadecimal digits with an optional "0x" prefix
LINE 1: SELECT th3index '8a2a100d645fffZZ@2012-01-01 08:00:00';
                        ^
-- Well-formed hexadecimal that denotes no cell, directed edge or vertex
SELECT th3index '12345@2012-01-01 08:00:00';
ERROR:  invalid h3index input "12345": not a valid H3 cell, directed edge or vertex
LINE 1: SELECT th3index '12345@2012-01-01 08:00:00';
                        ^
SELECT th3index '0xabc@2012-01-01 08:00:00';
ERROR:  invalid h3index input "0xabc": not a valid H3 cell, directed edge or vertex
LINE 1: SELECT th3index '0xabc@2012-01-01 08:00:00';
                        ^
SELECT th3index 'ffffffffffffffff@2012-01-01 08:00:00';
ERROR:  invalid h3index input "ffffffffffffffff": not a valid H3 cell, directed edge or vertex
LINE 1: SELECT th3index 'ffffffffffffffff@2012-01-01 08:00:00';
                        ^
-------------------------------------------------------------------------------
-- Temporal discrete sequence
SELECT th3index ' { 8a2a100d645ffff@2001-01-01 08:00:00 , 8a2a100d6457fff@2001-01-01 08:05:00 , 8a2a100d64effff@2001-01-01 08:06:00 } ';
                                                                  th3index                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------
 {8a2a100d645ffff@Mon Jan 01 08:00:00 2001 PST, 8a2a100d6457fff@Mon Jan 01 08:05:00 2001 PST, 8a2a100d64effff@Mon Jan 01 08:06:00 2001 PST}
(1 row)

SELECT th3index '{8a2a100d645ffff@2001-01-01 08:00:00,8a2a100d6457fff@2001-01-01 08:05:00,8a2a100d64effff@2001-01-01 08:06:00}';
                                                                  th3index                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------
 {8a2a100d645ffff@Mon Jan 01 08:00:00 2001 PST, 8a2a100d6457fff@Mon Jan 01 08:05:00 2001 PST, 8a2a100d64effff@Mon Jan 01 08:06:00 2001 PST}
(1 row)

/* Errors */
SELECT th3index '{8a2a100d645ffff@2001-01-01, 8a2a100d6457fff@2001-01-02, 8a2a100d64effff@2001-01-03';
ERROR:  Could not parse th3index value: Missing closing brace
LINE 2: SELECT th3index '{8a2a100d645ffff@2001-01-01, 8a2a100d6457ff...
                        ^
SELECT th3index '{8a2a100d645ffff@2001-01-01, 8a2a100d6457fff@2001-01-02, 8a2a100d64effff@2001-01-03},';
ERROR:  Could not parse th3index value: Extraneous characters at the end
LINE 1: SELECT th3index '{8a2a100d645ffff@2001-01-01, 8a2a100d6457ff...
                        ^
-------------------------------------------------------------------------------
-- Temporal continuous sequence (step interpolation is inherited from T_INT8)
SELECT th3index ' [ 8a2a100d645ffff@2001-01-01 08:00:00 , 8a2a100d6457fff@2001-01-01 08:05:00 , 8a2a100d64effff@2001-01-01 08:06:00 ] ';
                                                                  th3index                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------
 [8a2a100d645ffff@Mon Jan 01 08:00:00 2001 PST, 8a2a100d6457fff@Mon Jan 01 08:05:00 2001 PST, 8a2a100d64effff@Mon Jan 01 08:06:00 2001 PST]
(1 row)

SELECT th3index '[8a2a100d645ffff@2001-01-01 08:00:00,8a2a100d6457fff@2001-01-01 08:05:00,8a2a100d64effff@2001-01-01 08:06:00]';
                                                                  th3index                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------
 [8a2a100d645ffff@Mon Jan 01 08:00:00 2001 PST, 8a2a100d6457fff@Mon Jan 01 08:05:00 2001 PST, 8a2a100d64effff@Mon Jan 01 08:06:00 2001 PST]
(1 row)

SELECT th3index 'Interp=Step;[8a2a100d645ffff@2001-01-01 08:00:00,8a2a100d6457fff@2001-01-01 08:05:00,8a2a100d64effff@2001-01-01 08:06:00]';
                                                                  th3index                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------
 [8a2a100d645ffff@Mon Jan 01 08:00:00 2001 PST, 8a2a100d6457fff@Mon Jan 01 08:05:00 2001 PST, 8a2a100d64effff@Mon Jan 01 08:06:00 2001 PST]
(1 row)

/* Errors */
SELECT th3index 'Interp=Linear;[8a2a100d645ffff@2001-01-01 08:00:00,8a2a100d6457fff@2001-01-01 08:05:00,8a2a100d64effff@2001-01-01 08:06:00]';
ERROR:  The temporal type cannot have linear interpolation
LINE 2: SELECT th3index 'Interp=Linear;[8a2a100d645ffff@2001-01-01 0...
                        ^
-------------------------------------------------------------------------------
-- Temporal sequence set
SELECT th3index ' { [ 8a2a100d645ffff@2001-01-01 08:00:00 , 8a2a100d6457fff@2001-01-01 08:05:00 ] , [ 8a2a100d64effff@2001-01-01 08:10:00 , 8a2a100d67b7fff@2001-01-01 08:15:00 ] } ';
                                                                                           th3index                                                                                           
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[8a2a100d645ffff@Mon Jan 01 08:00:00 2001 PST, 8a2a100d6457fff@Mon Jan 01 08:05:00 2001 PST], [8a2a100d64effff@Mon Jan 01 08:10:00 2001 PST, 8a2a100d67b7fff@Mon Jan 01 08:15:00 2001 PST]}
(1 row)

SELECT th3index '{[8a2a100d645ffff@2001-01-01 08:00:00,8a2a100d6457fff@2001-01-01 08:05:00],[8a2a100d64effff@2001-01-01 08:10:00,8a2a100d67b7fff@2001-01-01 08:15:00]}';
                                                                                           th3index                                                                                           
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[8a2a100d645ffff@Mon Jan 01 08:00:00 2001 PST, 8a2a100d6457fff@Mon Jan 01 08:05:00 2001 PST], [8a2a100d64effff@Mon Jan 01 08:10:00 2001 PST, 8a2a100d67b7fff@Mon Jan 01 08:15:00 2001 PST]}
(1 row)

-------------------------------------------------------------------------------
-- MF-JSON input/output (h3index cell ids are serialized as their int8 value,
-- mirroring the tbigint sibling)
-------------------------------------------------------------------------------
SELECT asMFJSON(th3index '880326b885fffff@2012-01-01 08:00:00');
                                                                                    asmfjson                                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingH3Index","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"values":["880326b885fffff"],"datetimes":["2012-01-01T08:00:00-08:00"],"interpolation":"None"}
(1 row)

SELECT asMFJSON(th3index '{880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02}');
                                                                                                                              asmfjson                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingH3Index","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"values":["880326b885fffff","880326b88dfffff"],"datetimes":["2001-01-01T00:00:00-08:00","2001-01-02T00:00:00-08:00"],"lower_inc":true,"upper_inc":true,"interpolation":"Discrete"}
(1 row)

SELECT asMFJSON(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]');
                                                                                                                            asmfjson                                                                                                                            
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingH3Index","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"values":["880326b885fffff","880326b88dfffff"],"datetimes":["2001-01-01T00:00:00-08:00","2001-01-02T00:00:00-08:00"],"lower_inc":true,"upper_inc":true,"interpolation":"Step"}
(1 row)

SELECT asMFJSON(th3index '{[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02], [880326b885fffff@2001-01-03, 880326b885fffff@2001-01-04]}');
                                                                                                                                                                                                                asmfjson                                                                                                                                                                                                                 
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"type":"MovingH3Index","crs":{"type":"Name","properties":{"name":"EPSG:4326"}},"sequences":[{"values":["880326b885fffff","880326b88dfffff"],"datetimes":["2001-01-01T00:00:00-08:00","2001-01-02T00:00:00-08:00"],"lower_inc":true,"upper_inc":true},{"values":["880326b885fffff","880326b885fffff"],"datetimes":["2001-01-03T00:00:00-08:00","2001-01-04T00:00:00-08:00"],"lower_inc":true,"upper_inc":true}],"interpolation":"Step"}
(1 row)

-- Bound the geodetic bbox precision so the output is platform-independent
SELECT asMFJSON(th3index '880326b885fffff@2012-01-01 08:00:00', 1, 3, 6);
                 asmfjson                  
-------------------------------------------
 {                                        +
   "type": "MovingH3Index",               +
   "crs": {                               +
     "type": "Name",                      +
     "properties": {                      +
       "name": "EPSG:4326"                +
     }                                    +
   },                                     +
   "bbox": [                              +
     [                                    +
       64.287223,                         +
       89.573506                          +
     ],                                   +
     [                                    +
       65.602001,                         +
       89.583016                          +
     ]                                    +
   ],                                     +
   "period": {                            +
     "begin": "2012-01-01T08:00:00-08:00",+
     "end": "2012-01-01T08:00:00-08:00",  +
     "lower_inc": true,                   +
     "upper_inc": true                    +
   },                                     +
   "values": [                            +
     "880326b885fffff"                    +
   ],                                     +
   "datetimes": [                         +
     "2012-01-01T08:00:00-08:00"          +
   ],                                     +
   "interpolation": "None"                +
 }
(1 row)

-- Round-trip: th3indexFromMFJSON(asMFJSON(...)) preserves the value
SELECT th3indexFromMFJSON(asMFJSON(th3index '880326b885fffff@2012-01-01 08:00:00'));
              th3indexfrommfjson              
----------------------------------------------
 880326b885fffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

SELECT th3indexFromMFJSON(asMFJSON(th3index '{880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02}'));
                                      th3indexfrommfjson                                      
----------------------------------------------------------------------------------------------
 {880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT th3indexFromMFJSON(asMFJSON(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]'));
                                      th3indexfrommfjson                                      
----------------------------------------------------------------------------------------------
 [880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT th3indexFromMFJSON(asMFJSON(th3index '{[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02], [880326b885fffff@2001-01-03, 880326b885fffff@2001-01-04]}'));
                                                                                      th3indexfrommfjson                                                                                      
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST], [880326b885fffff@Wed Jan 03 00:00:00 2001 PST, 880326b885fffff@Thu Jan 04 00:00:00 2001 PST]}
(1 row)

-- A cell is written as its text form in a JSON string, and an integer is still
-- read as the cell it encodes; the bounding box is the spatiotemporal box
SELECT asMFJSON(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]', 1, 3, 6);
                 asmfjson                  
-------------------------------------------
 {                                        +
   "type": "MovingH3Index",               +
   "crs": {                               +
     "type": "Name",                      +
     "properties": {                      +
       "name": "EPSG:4326"                +
     }                                    +
   },                                     +
   "bbox": [                              +
     [                                    +
       64.104107,                         +
       89.564829                          +
     ],                                   +
     [                                    +
       65.602001,                         +
       89.583016                          +
     ]                                    +
   ],                                     +
   "period": {                            +
     "begin": "2001-01-01T00:00:00-08:00",+
     "end": "2001-01-02T00:00:00-08:00",  +
     "lower_inc": true,                   +
     "upper_inc": true                    +
   },                                     +
   "values": [                            +
     "880326b885fffff",                   +
     "880326b88dfffff"                    +
   ],                                     +
   "datetimes": [                         +
     "2001-01-01T00:00:00-08:00",         +
     "2001-01-02T00:00:00-08:00"          +
   ],                                     +
   "lower_inc": true,                     +
   "upper_inc": true,                     +
   "interpolation": "Step"                +
 }
(1 row)

SELECT th3indexFromMFJSON(replace(asMFJSON(th3index '880326b885fffff@2012-01-01 08:00:00'),
  '"880326b885fffff"', '612544986753269759'));
              th3indexfrommfjson              
----------------------------------------------
 880326b885fffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

