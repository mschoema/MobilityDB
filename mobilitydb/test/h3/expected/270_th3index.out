(1 row)

SELECT th3index(SequenceSet) '{[8a2a100d645ffff@2001-01-01, 8a2a100d6457fff@2001-01-02]}';
                                            th3index                                            
------------------------------------------------------------------------------------------------
 {[8a2a100d645ffff@Mon Jan 01 00:00:00 2001 PST, 8a2a100d6457fff@Tue Jan 02 00:00:00 2001 PST]}
(1 row)

/* Errors */
SELECT th3index(Instant) '{8a2a100d645ffff@2001-01-01, 8a2a100d6457fff@2001-01-02}';
ERROR:  Temporal type (Sequence) does not match column type (Instant)
SELECT th3index(Sequence) '8a2a100d645ffff@2012-01-01 08:00:00';
ERROR:  Temporal type (Instant) does not match column type (Sequence)
SELECT th3index(Garbage) '8a2a100d645ffff@2012-01-01 08:00:00';
ERROR:  Invalid temporal type modifier: garbage
LINE 1: SELECT th3index(Garbage) '8a2a100d645ffff@2012-01-01 08:00:0...
               ^
-------------------------------------------------------------------------------
-- WKB / HexWKB round-trips
-------------------------------------------------------------------------------
SELECT asText(th3indexFromBinary(asBinary(th3index '880326b885fffff@2001-01-01')));
                    astext                    
----------------------------------------------
 880326b885fffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asText(th3indexFromBinary(asBinary(th3index '{880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02}')));
                                            astext                                            
----------------------------------------------------------------------------------------------
 {880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT asText(th3indexFromBinary(asBinary(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]')));
                                            astext                                            
----------------------------------------------------------------------------------------------
 [880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asText(th3indexFromBinary(asBinary(th3index '{[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02], [880326b885fffff@2001-01-03, 880326b885fffff@2001-01-04]}')));
                                                                                            astext                                                                                            
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST], [880326b885fffff@Wed Jan 03 00:00:00 2001 PST, 880326b885fffff@Thu Jan 04 00:00:00 2001 PST]}
(1 row)

-- Little-endian (NDR)
SELECT asText(th3indexFromBinary(asBinary(th3index '880326b885fffff@2001-01-01', 'NDR')));
                    astext                    
----------------------------------------------
 880326b885fffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asText(th3indexFromHexWKB(asHexWKB(th3index '880326b885fffff@2001-01-01')));
                    astext                    
----------------------------------------------
 880326b885fffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

-------------------------------------------------------------------------------
-- Extended forms
-- A cell states SRID 4326, so the extended forms state it and a stated SRID
-- is refused unless it is that one
-------------------------------------------------------------------------------
SELECT asEWKT(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]');
                                                 asewkt                                                 
--------------------------------------------------------------------------------------------------------
 SRID=4326;[880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asText(th3indexFromText(asText(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]')));
                                            astext                                            
----------------------------------------------------------------------------------------------
 [880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asEWKT(th3indexFromEWKT(asEWKT(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]')));
                                                 asewkt                                                 
--------------------------------------------------------------------------------------------------------
 SRID=4326;[880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asEWKT(asEWKT(th3index '[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02]')::th3index);
                                                 asewkt                                                 
--------------------------------------------------------------------------------------------------------
 SRID=4326;[880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asEWKT(th3indexFromEWKB(asEWKB(th3index '{880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02}')));
                                                 asewkt                                                 
--------------------------------------------------------------------------------------------------------
 SRID=4326;{880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT asEWKT(th3indexFromEWKB(asEWKB(th3index '880326b885fffff@2001-01-01', 'NDR')));
                         asewkt                         
--------------------------------------------------------
 SRID=4326;880326b885fffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asEWKT(th3indexFromHexEWKB(asHexEWKB(th3index '{[880326b885fffff@2001-01-01, 880326b88dfffff@2001-01-02], [880326b885fffff@2001-01-03, 880326b885fffff@2001-01-04]}')));
                                                                                                 asewkt                                                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 SRID=4326;{[880326b885fffff@Mon Jan 01 00:00:00 2001 PST, 880326b88dfffff@Tue Jan 02 00:00:00 2001 PST], [880326b885fffff@Wed Jan 03 00:00:00 2001 PST, 880326b885fffff@Thu Jan 04 00:00:00 2001 PST]}
(1 row)

SELECT asEWKT(th3indexFromEWKT('SRID=4326;880326b885fffff@2001-01-01'));
                         asewkt                         
--------------------------------------------------------
 SRID=4326;880326b885fffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

-- The extended binary form states SRID 4326
SELECT asHexEWKB(th3index '880326b885fffff@2001-01-01', 'XDR') LIKE '%000010E6%';
 ?column? 
----------
 t
(1 row)

-- Another SRID is refused, in text and in binary
SELECT th3indexFromEWKT('SRID=3857;880326b885fffff@2001-01-01');
ERROR:  The SRID of the h3index (4326) does not match the SRID of the th3index (3857)
SELECT th3indexFromHexEWKB(replace(asHexEWKB(th3index '880326b885fffff@2001-01-01', 'XDR'), '000010E6', '00000F11'));
ERROR:  The SRID of the WKB (3857) does not match the SRID of the th3index (4326)
-------------------------------------------------------------------------------
-- Assignment casts to/from tbigint
--
-- Casts are explicit (AS ASSIGNMENT) and bidirectional. Binary-coercion
-- casts are zero-copy: the on-disk representation is identical.
-------------------------------------------------------------------------------
-- tbigint -> th3index (explicit via ::)
SELECT (tbigint '622236723497533439@2012-01-01 08:00:00')::th3index;
                   th3index                   
----------------------------------------------
 8a2a100d645ffff@Sun Jan 01 08:00:00 2012 PST
(1 row)

SELECT (tbigint '{622236723497533439@2001-01-01, 622236723497500671@2001-01-02}')::th3index;
                                           th3index                                           
----------------------------------------------------------------------------------------------
 {8a2a100d645ffff@Mon Jan 01 00:00:00 2001 PST, 8a2a100d6457fff@Tue Jan 02 00:00:00 2001 PST}
(1 row)

SELECT (tbigint '[622236723497533439@2001-01-01, 622236723497500671@2001-01-02]')::th3index;
                                           th3index                                           
----------------------------------------------------------------------------------------------
 [8a2a100d645ffff@Mon Jan 01 00:00:00 2001 PST, 8a2a100d6457fff@Tue Jan 02 00:00:00 2001 PST]
(1 row)

-- th3index -> tbigint (explicit via ::)
SELECT (th3index '8a2a100d645ffff@2012-01-01 08:00:00')::tbigint;
                     tbigint                     
-------------------------------------------------
 622236723497533439@Sun Jan 01 08:00:00 2012 PST
(1 row)

-- An integer entering th3index is read as the text input reads its string: a
-- directed edge and the zero sentinel are H3 indexes, and an integer that is no
-- cell, directed edge or vertex is refused by the cast, in an assignment, and
-- in MF-JSON and WKB input
SELECT (tbigint '1270755069838884863@2001-01-01')::th3index;
                   th3index                    
-----------------------------------------------
 11a2a100d645ffff@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT (tbigint '0@2001-01-01')::th3index;
            th3index            
--------------------------------
 0@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT h3indexsetFromHexWKB(asHexWKB(h3OriginToDirectedEdges(h3index '8a2a100d645ffff')))
  = h3OriginToDirectedEdges(h3index '8a2a100d645ffff');
 ?column? 
----------
 t
(1 row)

/* Errors */
SELECT (tbigint '622236723497533440@2001-01-01')::th3index;
ERROR:  The value 622236723497533440 does not encode a valid H3 cell, directed edge or vertex
