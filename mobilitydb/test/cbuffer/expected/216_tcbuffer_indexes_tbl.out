INSERT INTO test_tcbuffer_idx(op, no_idx) VALUES ('tstzspan @> tcbuffer', (SELECT COUNT(*) FROM tbl_tcbuffer_span t2, tbl_tcbuffer_idx t1 WHERE t2.t @> t1.temp)::text);
