INSERT INTO test_tcbuffer_idx(op, no_idx) VALUES ('stbox >> tcbuffer', (SELECT COUNT(*) FROM tbl_tcbuffer_box t2, tbl_tcbuffer_idx t1 WHERE t2.b >> t1.temp)::text);
