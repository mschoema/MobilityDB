-- Verify that the postgis_raster extension is loaded.
-- pg_regress creates it before mobilitydb when MobilityDB is built with
-- -DQUADBIN=ON -DRASTER=ON.
SELECT COUNT(*) = 1 AS postgis_raster_loaded
FROM pg_extension
WHERE extname = 'postgis_raster';
 postgis_raster_loaded 
-----------------------
 t
(1 row)

