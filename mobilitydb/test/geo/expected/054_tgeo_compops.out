-------------------------------------------------------------------------------
-- Ever/always equal 
-------------------------------------------------------------------------------
SELECT geometry 'Point(1 1)' ?= tgeometry 'Point(1 1)@2001-01-01';
 ?column? 
----------
 t
(1 row)

SELECT geometry 'Point(1 1)' ?<> tgeometry 'Point(1 1)@2001-01-01';
 ?column? 
----------
 f
(1 row)

SELECT geometry 'Point(1 1)' %= tgeometry 'Point(1 1)@2001-01-01';
 ?column? 
----------
 t
(1 row)

SELECT geometry 'Point(1 1)' %<> tgeometry 'Point(1 1)@2001-01-01';
 ?column? 
----------
 f
(1 row)

