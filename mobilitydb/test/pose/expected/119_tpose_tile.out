-------------------------------------------------------------------------------
-- Regression tests for the tpose tile surface (119_tpose_tile.in.sql).
--
-- Every function converts its pose operand to the temporal geometry point
-- its position resolves to (tpose::tgeompoint) and delegates to the
-- temporal geometry point tile function, so a value keeps the
-- interpolation it carries: a sequence with the default linear
-- interpolation is tiled along its trajectory, and the split functions
-- rebuild the tpose fragment by restricting the original value to the time
-- extent of each tile.
--
-------------------------------------------------------------------------------
-- Test for NULL inputs since the functions are STRICT
SELECT spaceBoxes(NULL::tpose, 2.0);
 spaceboxes 
------------
 
(1 row)

SELECT spaceBoxes(tpose 'Pose(Point(1 1), 0.1)@2001-01-01', NULL::float);
 spaceboxes 
------------
 
(1 row)

-------------------------------------------------------------------------------
-- Boxes: a linear sequence is tiled along its trajectory and agrees with the
-- cast written out by hand
-------------------------------------------------------------------------------
SELECT spaceBoxes(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]', 2.0);
                                                                                   spaceboxes                                                                                    
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"STBOX XT(((1,1),(2,2)),[Mon Jan 01 00:00:00 2001 PST, Tue Jan 02 00:00:00 2001 PST))","STBOX XT(((2,2),(3,3)),[Tue Jan 02 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST])"}
(1 row)

SELECT spaceBoxes(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]', 2.0) =
  spaceBoxes(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]'::tgeompoint, 2.0) AS agrees_geo;
 agrees_geo 
------------
 t
(1 row)

SELECT spaceBoxes(tpose '{Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03}', 2.0) AS step_control;
                                                                                  step_control                                                                                   
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"STBOX XT(((1,1),(1,1)),[Mon Jan 01 00:00:00 2001 PST, Mon Jan 01 00:00:00 2001 PST])","STBOX XT(((3,3),(3,3)),[Wed Jan 03 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST])"}
(1 row)

SELECT timeBoxes(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]', interval '1 day', '2001-01-01');
                                                                                                                               timeboxes                                                                                                                                
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"STBOX XT(((1,1),(2,2)),[Mon Jan 01 00:00:00 2001 PST, Tue Jan 02 00:00:00 2001 PST))","STBOX XT(((2,2),(3,3)),[Tue Jan 02 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST))","STBOX XT(((3,3),(3,3)),[Wed Jan 03 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST])"}
(1 row)

SELECT spaceTimeBoxes(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]', 2.0, interval '1 day',
  geometry 'Point(0 0)', '2001-01-01');
                                                                                                                             spacetimeboxes                                                                                                                             
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"STBOX XT(((1,1),(2,2)),[Mon Jan 01 00:00:00 2001 PST, Tue Jan 02 00:00:00 2001 PST))","STBOX XT(((2,2),(3,3)),[Tue Jan 02 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST))","STBOX XT(((3,3),(3,3)),[Wed Jan 03 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST])"}
(1 row)

-------------------------------------------------------------------------------
-- Splits: each fragment is a tpose restricted to the time extent of its tile
-------------------------------------------------------------------------------
SELECT (spaceSplit(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]', 2.0)).*;
                   point                    |                                                                                    tpose                                                                                     
--------------------------------------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 010100000000000000000000000000000000000000 | {[POSE (0101000000000000000000F03F000000000000F03F, 0.1)@Mon Jan 01 00:00:00 2001 PST, POSE (010100000000000000000000400000000000000040, 0.1)@Tue Jan 02 00:00:00 2001 PST)}
 010100000000000000000000400000000000000040 | {[POSE (010100000000000000000000400000000000000040, 0.1)@Tue Jan 02 00:00:00 2001 PST, POSE (010100000000000000000008400000000000000840, 0.1)@Wed Jan 03 00:00:00 2001 PST]}
(2 rows)

SELECT (spaceTimeSplit(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]', 2.0, interval '1 day',
  geometry 'Point(0 0)', '2001-01-01')).*;
                   point                    |             time             |                                                                                    tpose                                                                                     
--------------------------------------------+------------------------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 010100000000000000000000000000000000000000 | Mon Jan 01 00:00:00 2001 PST | {[POSE (0101000000000000000000F03F000000000000F03F, 0.1)@Mon Jan 01 00:00:00 2001 PST, POSE (010100000000000000000000400000000000000040, 0.1)@Tue Jan 02 00:00:00 2001 PST)}
 010100000000000000000000400000000000000040 | Tue Jan 02 00:00:00 2001 PST | {[POSE (010100000000000000000000400000000000000040, 0.1)@Tue Jan 02 00:00:00 2001 PST, POSE (010100000000000000000008400000000000000840, 0.1)@Wed Jan 03 00:00:00 2001 PST)}
 010100000000000000000000400000000000000040 | Wed Jan 03 00:00:00 2001 PST | {[POSE (010100000000000000000008400000000000000840, 0.1)@Wed Jan 03 00:00:00 2001 PST]}
(3 rows)

SELECT (timeSplit(tpose '[Pose(Point(1 1),0.1)@2001-01-01,
  Pose(Point(3 3),0.1)@2001-01-03]', interval '1 day', '2001-01-01')).*;
             time             |                                                                                    temp                                                                                    
------------------------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Mon Jan 01 00:00:00 2001 PST | [POSE (0101000000000000000000F03F000000000000F03F, 0.1)@Mon Jan 01 00:00:00 2001 PST, POSE (010100000000000000000000400000000000000040, 0.1)@Tue Jan 02 00:00:00 2001 PST)
 Tue Jan 02 00:00:00 2001 PST | [POSE (010100000000000000000000400000000000000040, 0.1)@Tue Jan 02 00:00:00 2001 PST, POSE (010100000000000000000008400000000000000840, 0.1)@Wed Jan 03 00:00:00 2001 PST)
 Wed Jan 03 00:00:00 2001 PST | [POSE (010100000000000000000008400000000000000840, 0.1)@Wed Jan 03 00:00:00 2001 PST]
(3 rows)

