-------------------------------------------------------------------------------
-- Input
-------------------------------------------------------------------------------
SELECT asText(tpose 'Pose(Point(1 1), 0.5)@2001-01-01');
                      astext                       
---------------------------------------------------
 Pose(POINT(1 1),0.5)@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asText(tpose '{Pose(Point(1 1), 0.3)@2001-01-01, Pose(Point(1 1), 0.5)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03}');
                                                                          astext                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 {Pose(POINT(1 1),0.3)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST}
(1 row)

SELECT asText(tpose '[Pose(Point(1 1), 0.2)@2001-01-01, Pose(Point(1 1), 0.4)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03]');
                                                                          astext                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 [Pose(POINT(1 1),0.2)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.4)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST]
(1 row)

SELECT asText(tpose '{[Pose(Point(1 1), 0.2)@2001-01-01, Pose(Point(1 1), 0.4)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03], [Pose(Point(2 2), 0.6)@2001-01-04, Pose(Point(2 2), 0.6)@2001-01-05]}');
                                                                                                                               astext                                                                                                                                
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[Pose(POINT(1 1),0.2)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.4)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST], [Pose(POINT(2 2),0.6)@Thu Jan 04 00:00:00 2001 PST, Pose(POINT(2 2),0.6)@Fri Jan 05 00:00:00 2001 PST]}
(1 row)

SELECT asText(tpose 'Interp=Step;[Pose(Point(1 1), 0.2)@2001-01-01, Pose(Point(1 1), 0.4)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03]');
                                                                                astext                                                                                 
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Interp=Step;[Pose(POINT(1 1),0.2)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.4)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST]
(1 row)

SELECT asText(tpose 'Interp=Step;{[Pose(Point(1 1), 0.2)@2001-01-01, Pose(Point(1 1), 0.4)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03], [Pose(Point(2 2), 0.6)@2001-01-04, Pose(Point(2 2), 0.6)@2001-01-05] }');
                                                                                                                                     astext                                                                                                                                      
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Interp=Step;{[Pose(POINT(1 1),0.2)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.4)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST], [Pose(POINT(2 2),0.6)@Thu Jan 04 00:00:00 2001 PST, Pose(POINT(2 2),0.6)@Fri Jan 05 00:00:00 2001 PST]}
(1 row)

SELECT asText(tpose '  Pose (  Point(1 1)  ,   0.5  )  @  2001-01-01  ');
                      astext                       
---------------------------------------------------
 Pose(POINT(1 1),0.5)@Mon Jan 01 00:00:00 2001 PST
(1 row)

SELECT asText(tpose '  {  Pose( Point(1 1) , 0.3 ) @ 2001-01-01  , Pose(Point(1 1), 0.5)@2001-01-02, Pose(Point(1 1), 0.5) @  2001-01-03   }   ');
                                                                          astext                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 {Pose(POINT(1 1),0.3)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST}
(1 row)

SELECT asText(tpose '  [  Pose(Point(1 1), 0.2)@2001-01-01, Pose(Point(1 1), 0.4)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03]');
                                                                          astext                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 [Pose(POINT(1 1),0.2)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.4)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST]
(1 row)

SELECT asText(tpose '  {  [  Pose(Point(1 1), 0.2)@2001-01-01 ,  Pose  (  Point(1 1) , 0.4 ) @2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03], [Pose(Point(2 2), 0.6)@2001-01-04, Pose(Point(2 2), 0.6)@2001-01-05]}');
                                                                                                                               astext                                                                                                                                
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[Pose(POINT(1 1),0.2)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.4)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST], [Pose(POINT(2 2),0.6)@Thu Jan 04 00:00:00 2001 PST, Pose(POINT(2 2),0.6)@Fri Jan 05 00:00:00 2001 PST]}
(1 row)

-- Normalization
SELECT asText(tpose '[Pose(Point(1 1), 0.3)@2001-01-01, Pose(Point(1 1), 0.4)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03]');
                                                 astext                                                 
--------------------------------------------------------------------------------------------------------
 [Pose(POINT(1 1),0.3)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST]
(1 row)

SELECT asText(tpose '{[Pose(Point(1 1), 0.3)@2001-01-01, Pose(Point(1 1), 0.4)@2001-01-02, Pose(Point(1 1), 0.5)@2001-01-03], [Pose(Point(2 2), 0.6)@2001-01-04, Pose(Point(2 2), 0.6)@2001-01-05, Pose(Point(2 2), 0.6)@2001-01-06]}');
                                                                                                      astext                                                                                                      
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[Pose(POINT(1 1),0.3)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 1),0.5)@Wed Jan 03 00:00:00 2001 PST], [Pose(POINT(2 2),0.6)@Thu Jan 04 00:00:00 2001 PST, Pose(POINT(2 2),0.6)@Sat Jan 06 00:00:00 2001 PST]}
(1 row)

