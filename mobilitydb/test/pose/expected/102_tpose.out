(1 row)

SELECT asText(tpose 'Interp=Step;[Pose(Point(1 1), 0.123456789)@2001-01-01, Pose(Point(1 1), 0.523456789)@2001-01-02, Pose(Point(1 1), 0.123456789)@2001-01-03]', 6);
                                                                                        astext                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
