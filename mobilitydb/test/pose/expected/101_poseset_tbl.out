-------------------------------------------------------------------------------
-- Tests for the set data type
-- File set.c
-------------------------------------------------------------------------------
-- Send/receive functions
\copy tbl_poseset2d TO 'tbl_poseset2d' (FORMAT BINARY);
DROP TABLE IF EXISTS tbl_poseset2d_tmp;
NOTICE:  table "tbl_poseset2d_tmp" does not exist, skipping
CREATE TEMP TABLE tbl_poseset2d_tmp AS TABLE tbl_poseset2d WITH NO DATA;
\copy tbl_poseset2d_tmp FROM 'tbl_poseset2d' (FORMAT BINARY);
SELECT COUNT(*) FROM tbl_poseset2d t1, tbl_poseset2d_tmp t2 WHERE t1.k = t2.k AND t1.s <> t2.s;
 count 
-------
     0
(1 row)

DROP TABLE tbl_poseset2d_tmp;
-- Input/output from/to WKB and HexWKB
-- asBinary emits plain WKB (no SRID); setSRID reapplies it before comparing
SELECT COUNT(*) FROM tbl_poseset2d WHERE setSRID(posesetFromBinary(asBinary(s)), 3812) <> s;
 count 
-------
     0
(1 row)

SELECT COUNT(*) FROM tbl_poseset2d WHERE SRID(posesetFromBinary(asBinary(s))) <> 0;
 count 
-------
     0
(1 row)

-- asEWKB preserves the SRID
SELECT COUNT(*) FROM tbl_poseset2d WHERE posesetFromBinary(asEWKB(s)) <> s;
 count 
-------
     0
(1 row)

-- asHexWKB emits plain WKB (no SRID); setSRID reapplies it before comparing
SELECT COUNT(*) FROM tbl_poseset2d WHERE setSRID(posesetFromHexWKB(asHexWKB(s)), 3812) <> s;
 count 
-------
     0
(1 row)

SELECT COUNT(*) FROM tbl_poseset2d WHERE posesetFromHexWKB(asHexEWKB(s)) <> s;
 count 
-------
     0
(1 row)

SELECT COUNT(*) FROM tbl_poseset2d WHERE posesetFromHexEWKB(asHexEWKB(s)) <> s;
 count 
-------
     0
(1 row)

