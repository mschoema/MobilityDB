     "validTime":"2026-01-01 00:00:00+01"},
    {"position":{"lat":48,"lon":9,"h":0},"quaternion":{"x":0,"y":0,"z":0,"w":1},
     "validTime":"2026-01-02 00:00:00+01"}]}'));
