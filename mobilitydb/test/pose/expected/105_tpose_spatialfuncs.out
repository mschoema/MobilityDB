 {[Pose(POINT(1 0),0)@Tue Jan 02 00:00:00 2001 PST, Pose(POINT(3 0),0)@Thu Jan 04 00:00:00 2001 PST]}
(1 row)

SELECT asText(minusStbox(
  tpose '[Pose(Point(0 0),0)@2001-01-01, Pose(Point(5 0),0)@2001-01-06]',
  stbox 'STBOX X((1,-1),(3,1))'));
                                                                                                  astext                                                                                                  
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[Pose(POINT(0 0),0)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1 0),0)@Tue Jan 02 00:00:00 2001 PST), (Pose(POINT(3 0),0)@Thu Jan 04 00:00:00 2001 PST, Pose(POINT(5 0),0)@Sat Jan 06 00:00:00 2001 PST]}
(1 row)

