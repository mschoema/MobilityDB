---------------------------------------------------------------------------------------------------------------------------------
 [Pose(POINT(0.120625 1.40906),1)@Mon Jan 01 00:00:00 2001 PST, Pose(POINT(1.006091 3.462337),1.8)@Tue Jan 02 00:00:00 2001 PST]
(1 row)

SELECT asText(rotateX(tpose '[Pose(Point(1 1),0.3)@2001-01-01, Pose(Point(3 2),1.1)@2001-01-02]', 0.7), 6);
