  geometry 'Polygon((-1 -1,5 -1,5 2,-1 2,-1 -1))',
  trgeometry 'Polygon((0 0,1 0,1 1,0 1,0 0));[Pose(Point(0 0),0)@2001-01-01, Pose(Point(4 0),0)@2001-01-05]');
