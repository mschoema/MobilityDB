DROP TABLE IF EXISTS test_idxops;
NOTICE:  table "test_idxops" does not exist, skipping
CREATE TEMP TABLE test_idxops(
  op CHAR(3),
  leftarg TEXT,
  rightarg TEXT,
  no_idx BIGINT,
  rtree_idx BIGINT,
  quadtree_idx BIGINT,
  kdtree_idx BIGINT
);
