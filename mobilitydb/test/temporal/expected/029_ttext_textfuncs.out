--------------------------------------------------------------------------------------------------------------
 ["AAA"@Mon Jan 01 00:00:00 2001 PST, "BBA"@Tue Jan 02 00:00:00 2001 PST, "AAA"@Wed Jan 03 00:00:00 2001 PST]
(1 row)

SELECT ttext '{[AA@2001-01-01, BB@2001-01-02, AA@2001-01-03],[CC@2001-01-04, CC@2001-01-05]}' || text 'A';
                                                                                         ?column?                                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {["AAA"@Mon Jan 01 00:00:00 2001 PST, "BBA"@Tue Jan 02 00:00:00 2001 PST, "AAA"@Wed Jan 03 00:00:00 2001 PST], ["CCA"@Thu Jan 04 00:00:00 2001 PST, "CCA"@Fri Jan 05 00:00:00 2001 PST]}
