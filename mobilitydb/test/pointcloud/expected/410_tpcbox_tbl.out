-------------------------------------------------------------------------------
-- Table-level tests for tpcbox.
-------------------------------------------------------------------------------
-- Send / receive round-trip
-------------------------------------------------------------------------------
\copy tbl_tpcbox TO 'tbl_tpcbox' (FORMAT BINARY);
DROP TABLE IF EXISTS tbl_tpcbox_tmp;
NOTICE:  table "tbl_tpcbox_tmp" does not exist, skipping
CREATE TEMP TABLE tbl_tpcbox_tmp AS TABLE tbl_tpcbox WITH NO DATA;
\copy tbl_tpcbox_tmp FROM 'tbl_tpcbox' (FORMAT BINARY);
SELECT COUNT(*) FROM tbl_tpcbox t1, tbl_tpcbox_tmp t2 WHERE t1.k = t2.k AND t1.b <> t2.b;
 count 
-------
     0
(1 row)

DROP TABLE tbl_tpcbox_tmp;
-------------------------------------------------------------------------------
-- pcid uniformity + dimension flags
-------------------------------------------------------------------------------
SELECT bool_and(pcid(b) = 1) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

SELECT bool_and(hasX(b)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

SELECT bool_and(hasZ(b)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

SELECT bool_and(hasT(b)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- Range checks for the bounds
-------------------------------------------------------------------------------
SELECT bool_and(xmin(b) <= xmax(b)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

SELECT bool_and(ymin(b) <= ymax(b)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

SELECT bool_and(zmin(b) <= zmax(b)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

SELECT bool_and(tmin(b) <= tmax(b)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- Set operations preserve pcid
-------------------------------------------------------------------------------
SELECT bool_and(pcid(t1.b + t2.b) = 1)
FROM tbl_tpcbox t1, tbl_tpcbox t2;
 bool_and 
----------
 t
(1 row)

SELECT COUNT(*)
FROM tbl_tpcbox t1, tbl_tpcbox t2
WHERE (t1.b * t2.b) IS NOT NULL;
 count 
-------
   100
(1 row)

-------------------------------------------------------------------------------
-- Topological predicates self-relate sensibly
-------------------------------------------------------------------------------
-- Every box equals itself.
SELECT bool_and(b ~= b) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

-- Every box overlaps itself.
SELECT bool_and(b && b) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

-- Every box contains itself.
SELECT bool_and(b @> b) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- Comparison operators
-------------------------------------------------------------------------------
SELECT COUNT(*) FROM tbl_tpcbox t1, tbl_tpcbox t2 WHERE t1.b =  t2.b;
 count 
-------
   100
(1 row)

SELECT COUNT(*) FROM tbl_tpcbox t1, tbl_tpcbox t2 WHERE t1.b <> t2.b;
 count 
-------
  9900
(1 row)

SELECT COUNT(*) FROM tbl_tpcbox t1, tbl_tpcbox t2 WHERE t1.b <  t2.b;
 count 
-------
  4950
(1 row)

SELECT COUNT(*) FROM tbl_tpcbox t1, tbl_tpcbox t2 WHERE t1.b <= t2.b;
 count 
-------
  5050
(1 row)

-------------------------------------------------------------------------------
-- round / setSRID
-------------------------------------------------------------------------------
-- round(b, 0) is idempotent: applying it twice gives the same value.
SELECT bool_and(round(round(b, 0), 0) ~= round(b, 0)) FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

-- setSRID stamps the new SRID without touching pcid. The schema pcid 1 names
-- states no reference system, which is what leaves the box free to state one.
SELECT bool_and(SRID(setSRID(b, 4326)) = 4326 AND pcid(setSRID(b, 4326)) = pcid(b))
FROM tbl_tpcbox;
 bool_and 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- SP-GiST quadtree + kd-tree opclasses on tpcbox
-------------------------------------------------------------------------------
CREATE INDEX tbl_tpcbox_quadtree_idx ON tbl_tpcbox USING spgist(b);
SET enable_seqscan = on;
SET enable_indexscan = off;
SET enable_bitmapscan = off;
SELECT COUNT(*) AS seq_count FROM tbl_tpcbox WHERE b @> tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 seq_count 
-----------
         0
(1 row)

SELECT COUNT(*) AS seq_left FROM tbl_tpcbox WHERE b << tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 seq_left 
----------
       11
(1 row)

SELECT COUNT(*) AS seq_overleft FROM tbl_tpcbox WHERE b &< tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 seq_overleft 
--------------
           16
(1 row)

SELECT COUNT(*) AS seq_above FROM tbl_tpcbox WHERE b |>> tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 seq_above 
-----------
        46
(1 row)

SELECT COUNT(*) AS seq_front FROM tbl_tpcbox WHERE b <</ tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 seq_front 
-----------
         0
(1 row)

SELECT COUNT(*) AS seq_before FROM tbl_tpcbox WHERE b <<# tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 seq_before 
------------
          0
(1 row)

SET enable_seqscan = off;
SET enable_indexscan = on;
SET enable_bitmapscan = on;
SELECT COUNT(*) AS quadtree_count FROM tbl_tpcbox WHERE b @> tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 quadtree_count 
----------------
              0
(1 row)

SELECT COUNT(*) AS quadtree_left FROM tbl_tpcbox WHERE b << tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 quadtree_left 
---------------
            11
(1 row)

SELECT COUNT(*) AS quadtree_overleft FROM tbl_tpcbox WHERE b &< tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 quadtree_overleft 
-------------------
                16
(1 row)

SELECT COUNT(*) AS quadtree_above FROM tbl_tpcbox WHERE b |>> tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 quadtree_above 
----------------
             46
(1 row)

SELECT COUNT(*) AS quadtree_front FROM tbl_tpcbox WHERE b <</ tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 quadtree_front 
----------------
              0
(1 row)

SELECT COUNT(*) AS quadtree_before FROM tbl_tpcbox WHERE b <<# tpcboxZT(0, 0, 0,
  10, 10, 10, tstzspan '[2001-01-01, 2001-12-31]', 1);
 quadtree_before 
-----------------
               0
(1 row)

DROP INDEX tbl_tpcbox_quadtree_idx;
CREATE INDEX tbl_tpcbox_kdtree_idx ON tbl_tpcbox USING spgist(b tpcbox_kdtree_ops);
