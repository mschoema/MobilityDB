-------------------------------------------------------------------------------
-- SRID
-- Reading the SRID of a tpcpoint goes through the generic spatiotemporal
-- dispatcher. The instant form reads the schema of the value; the sequence
-- form reads the bounding box, whose leading layout is that of an STBox.
-- Both agree with the schema registered in pointcloud_formats.
-------------------------------------------------------------------------------
SELECT SRID(:inst1);
 srid 
------
    0
(1 row)

SELECT SRID(tpcpointSeq(ARRAY[:inst1, :inst2]));
 srid 
------
    0
(1 row)

SELECT SRID(tpcpointSeqSet(ARRAY[tpcpointSeq(ARRAY[:inst1, :inst2])]));
 srid 
------
    0
(1 row)

SELECT SRID(:inst1) = (SELECT srid FROM pointcloud_formats WHERE pcid = 1);
 ?column? 
----------
 t
(1 row)

SELECT SRID(tpcpointSeq(ARRAY[:inst1, :inst2])) = SRID(:inst1);
 ?column? 
----------
 t
(1 row)

-- The schema of pcid 1 declares SRID 0, so every equality above holds with
-- both sides zero and none of them can see an SRID that fails to arrive. A
-- schema declaring one is what makes them answer about the value.
INSERT INTO pointcloud_formats (pcid, srid, schema)
SELECT 4, 4326, schema FROM pointcloud_formats WHERE pcid = 1;
SELECT SRID(pcpoint(4, 1.0, 1.0, 1.0));
 srid 
------
 4326
(1 row)

SELECT SRID(tpcpoint(pcpoint(4, 1.0, 1.0, 1.0), '2024-01-01'::timestamptz));
 srid 
------
 4326
(1 row)

SELECT SRID(tpcpointSeq(ARRAY[
  tpcpoint(pcpoint(4, 1.0, 1.0, 1.0), '2024-01-01'::timestamptz),
  tpcpoint(pcpoint(4, 2.0, 2.0, 2.0), '2024-01-02'::timestamptz)]));
 srid 
------
 4326
(1 row)

SELECT SRID(pcpoint(4, 1.0, 1.0, 1.0)) =
  (SELECT srid FROM pointcloud_formats WHERE pcid = 4);
 ?column? 
----------
 t
(1 row)

-- a patch reads the SRID of its schema exactly as a point does
SELECT SRID(tpcpatch(PC_Patch(ARRAY[pcpoint(4, 1.0, 1.0, 1.0)]),
  '2024-01-01'::timestamptz));
 srid 
------
 4326
(1 row)

-- Values of two schemas do not share a set. The schemas decide it before the
-- SRIDs do: uniformity of pcid is the stricter requirement, since two schemas
-- may declare one SRID and still lay their dimensions out differently.
SELECT set(ARRAY[pcpoint(1, 1.0, 1.0, 1.0), pcpoint(4, 2.0, 2.0, 2.0)]);
ERROR:  Set elements have different pcpoint schemas: 1 vs 4
-- The plain binary form omits the SRID and round-trips under a schema that
-- declares one; the extended forms state the SRID of the schema and
-- round-trip as well.
WITH t AS (SELECT tpcpointSeq(ARRAY[
  tpcpoint(pcpoint(4, 1.0, 1.0, 1.0), '2024-01-01'::timestamptz),
  tpcpoint(pcpoint(4, 2.0, 2.0, 2.0), '2024-01-02'::timestamptz)]) AS temp)
SELECT tpcpointFromBinary(asBinary(temp)) = temp AS wkb_roundtrips,
  tpcpointFromEWKB(asEWKB(temp)) = temp AS ewkb_roundtrips,
  tpcpointFromHexEWKB(asHexEWKB(temp)) = temp AS hexewkb_roundtrips,
  tpcpointFromText(asText(temp)) = temp AS text_roundtrips,
  tpcpointFromEWKT(asEWKT(temp)) = temp AS ewkt_roundtrips,
  asEWKT(temp)::tpcpoint = temp AS ewkt_cast_roundtrips,
  octet_length(asEWKB(temp)) - octet_length(asBinary(temp)) AS extra_bytes,
  split_part(asEWKT(temp), ';', 1) AS ewkt_srid,
  SRID(temp) AS srid
FROM t;
 wkb_roundtrips | ewkb_roundtrips | hexewkb_roundtrips | text_roundtrips | ewkt_roundtrips | ewkt_cast_roundtrips | extra_bytes | ewkt_srid | srid 
----------------+-----------------+--------------------+-----------------+-----------------+----------------------+-------------+-----------+------
 t              | t               | t                  | t               | t               | t                    |           4 | SRID=4326 | 4326
(1 row)

-- A stated SRID other than the one of the schema is refused, in text and in
-- binary
SELECT tpcpointFromEWKT('SRID=3857;' ||
  asText(tpcpoint(pcpoint(4, 1.0, 1.0, 1.0), '2024-01-01'::timestamptz)));
ERROR:  The SRID of the pcpoint (4326) does not match the SRID of the tpcpoint (3857)
SELECT tpcpointFromHexEWKB(replace(asHexEWKB(
  tpcpoint(pcpoint(4, 1.0, 1.0, 1.0), '2024-01-01'::timestamptz), 'XDR'),
  '000010E6', '00000F11'));
ERROR:  The SRID of the WKB (3857) does not match the SRID of the tpcpoint (4326)
-- The array form states the SRID of each element, as the element-wise form does
WITH a AS (SELECT ARRAY[
  tpcpoint(pcpoint(4, 1.0, 1.0, 1.0), '2024-01-01'::timestamptz),
  tpcpoint(pcpoint(4, 2.0, 2.0, 2.0), '2024-01-02'::timestamptz)] AS arr)
SELECT asEWKT(arr) = ARRAY[asEWKT(arr[1]), asEWKT(arr[2])] AS elementwise,
  split_part((asEWKT(arr))[1], ';', 1) AS ewkt_srid
FROM a;
 elementwise | ewkt_srid 
-------------+-----------
 t           | SRID=4326
(1 row)

-- A schema declaring no SRID refuses a stated one
SELECT tpcpointFromEWKT('SRID=4326;' || asText(:inst1));
ERROR:  The SRID of a pcpoint is the one its schema declares and cannot be set
DELETE FROM pointcloud_formats WHERE pcid = 4;
-------------------------------------------------------------------------------
-- Unnest
-- One row per distinct value, with the span set on which the temporal value
-- takes it. A value occurring twice yields one row whose span set has two
-- spans, so the row count is the number of DISTINCT values.
-------------------------------------------------------------------------------
SELECT count(*) FROM unnest(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]));
 count 
-------
     3
(1 row)

SELECT count(*) FROM unnest(tpcpointSeq(ARRAY[:inst1, :inst2, :inst1rep]));
 count 
-------
     2
(1 row)

SELECT numSpans((u).time) FROM
  unnest(tpcpointSeq(ARRAY[:inst1, :inst2, :inst1rep])) u
  WHERE (u).value::text = (pcpoint(1, 1.0, 1.0, 1.0))::text;
 numspans 
----------
        2
(1 row)

-- Every span set is contained in the time span of the temporal value.
SELECT bool_and((u).time <@ timeSpan(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3])))
  FROM unnest(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3])) u;
 bool_and 
----------
 t
(1 row)

-------------------------------------------------------------------------------
-- Multidimensional tiling
-- timeSplit cuts a temporal value into the fragments falling in each time bin.
-------------------------------------------------------------------------------
SELECT count(*) FROM
  timeSplit(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]), interval '1 day');
 count 
-------
     3
(1 row)

SELECT count(*) FROM
  timeSplit(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]), interval '1 week');
 count 
-------
     1
(1 row)

-- The bins start at the origin, so shifting it shifts the fragments.
SELECT count(*) FROM timeSplit(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]),
  interval '2 days', timestamptz '2024-01-01');
 count 
-------
     2
(1 row)

-- Each fragment starts at or after the bin it is labelled with, and stays
-- inside the time span of the value it was cut from.
SELECT bool_and(time <= startTimestamp(temp))
  FROM timeSplit(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]), interval '1 day');
 bool_and 
----------
 t
(1 row)

SELECT bool_and(timeSpan(temp) <@
    timeSpan(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3])))
  FROM timeSplit(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]), interval '1 day');
 bool_and 
----------
 t
(1 row)

SELECT spans(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]));
                                                              spans                                                              
---------------------------------------------------------------------------------------------------------------------------------
 {"[Mon Jan 01 00:00:00 2024 PST, Tue Jan 02 00:00:00 2024 PST]","[Tue Jan 02 00:00:00 2024 PST, Wed Jan 03 00:00:00 2024 PST]"}
(1 row)

SELECT splitNSpans(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]), 2);
                                                           splitnspans                                                           
---------------------------------------------------------------------------------------------------------------------------------
 {"[Mon Jan 01 00:00:00 2024 PST, Tue Jan 02 00:00:00 2024 PST]","[Tue Jan 02 00:00:00 2024 PST, Wed Jan 03 00:00:00 2024 PST]"}
(1 row)

SELECT splitEachNSpans(tpcpointSeq(ARRAY[:inst1, :inst2, :inst3]), 2);
                         spliteachnspans                          
------------------------------------------------------------------
 {"[Mon Jan 01 00:00:00 2024 PST, Wed Jan 03 00:00:00 2024 PST]"}
(1 row)

-------------------------------------------------------------------------------
-- The text of a pcpoint
-- A pcpoint is read and written as the hex of its pgPointCloud Well-Known
-- Binary (WKB), the text the type input and output functions of pgPointCloud
-- read and write: the endian flag, the pcid and the data of the point. A
-- point in either byte order is read, and written in the order of the
-- machine.
-------------------------------------------------------------------------------
SELECT tpcpoint '010100000064000000C80000002C010000@2024-01-01';
                            tpcpoint                             
-----------------------------------------------------------------
 010100000064000000C80000002C010000@Mon Jan 01 00:00:00 2024 PST
(1 row)

SELECT tpcpoint '000000000100000064000000C80000012C@2024-01-01' =
  tpcpoint '010100000064000000C80000002C010000@2024-01-01';
 ?column? 
----------
 t
(1 row)

SELECT asText(set(ARRAY[PC_MakePoint(1, ARRAY[1.0, 2.0, 3.0]::float[])])) =
  '{"' || PC_MakePoint(1, ARRAY[1.0, 2.0, 3.0]::float[])::text || '"}';
 ?column? 
----------
 t
(1 row)

/* Errors */
SELECT tpcpoint '020100000064000000C80000002C010000@2024-01-01';
ERROR:  Could not parse pcpoint value: invalid endian flag 2
LINE 2: SELECT tpcpoint '020100000064000000C80000002C010000@2024-01-...
                        ^
SELECT tpcpoint '010100000064000000C8000000@2024-01-01';
ERROR:  Could not parse pcpoint value: 8 bytes of data where the schema 1 states 12
LINE 1: SELECT tpcpoint '010100000064000000C8000000@2024-01-01';
                        ^
-- pcpointFromHexWKB and asHexWKB read and write the text of the type input
-- and output functions of pgPointCloud
SELECT asHexWKB(pcpoint(1, 1.0, 2.0, 3.0));
              ashexwkb              
------------------------------------
 010100000064000000C80000002C010000
(1 row)

SELECT getZ(pcpointFromHexWKB('010100000064000000C80000002C010000'));
 getz 
------
    3
(1 row)

SELECT pcpointFromHexWKB('010100000064000000C80000002C010000') =
  '010100000064000000C80000002C010000'::pcpoint;
 ?column? 
----------
 t
(1 row)

SELECT pcpointFromHexWKB('000000000100000064000000C80000012C') =
  pcpointFromHexWKB('010100000064000000C80000002C010000');
 ?column? 
----------
 t
(1 row)

SELECT asHexWKB(PC_MakePoint(1, ARRAY[1.0, 2.0, 3.0]::float[])) =
  PC_MakePoint(1, ARRAY[1.0, 2.0, 3.0]::float[])::text;
 ?column? 
----------
 t
(1 row)

SELECT pcpointFromHexWKB(asHexWKB(pcpoint(1, 1.0, 2.0, 3.0))) =
  pcpoint(1, 1.0, 2.0, 3.0);
 ?column? 
----------
 t
(1 row)

/* Errors */
SELECT pcpointFromHexWKB('020100000064000000C80000002C010000');
ERROR:  Could not parse pcpoint value: invalid endian flag 2
SELECT pcpointFromHexWKB('010100000064000000C8000000');
ERROR:  Could not parse pcpoint value: 8 bytes of data where the schema 1 states 12
-------------------------------------------------------------------------------
-- A value whose pcid names no schema
-- The data of a pcpoint is laid out by the schema its pcid resolves to, so a
-- value naming a pcid no pointcloud_formats row declares is reported when it
-- is read, as the type input function of pgPointCloud reports it.
-------------------------------------------------------------------------------
SELECT tpcpoint '0163000000000000000000F03F00000000000000400000000000000840@2024-01-01';
ERROR:  No schema registered for pcid 99
LINE 1: SELECT tpcpoint '0163000000000000000000F03F00000000000000400...
                        ^
-------------------------------------------------------------------------------
