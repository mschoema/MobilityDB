-------------------------------------------------------------------------------
SELECT aIntersects(:p1, geometry 'SRID=0;POINT(0 0)');
 aintersects 
-------------
 t
(1 row)

SELECT aIntersects(:seq, geometry 'SRID=0;POINT(0 0)');
 aintersects 
-------------
 f
(1 row)

