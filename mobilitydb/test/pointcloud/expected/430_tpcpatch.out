  pcpoint(1, 2, 2, 2)), tstzspan '[2001-01-01, 2001-01-02]')),
  interp(tpcpatch(pcpatch(pcpoint(1, 1, 1, 1),
  pcpoint(1, 2, 2, 2)), tstzspan '[2001-01-01, 2001-01-02]'));
 tempsubtype | interp 
-------------+--------
 Sequence    | Step
(1 row)

