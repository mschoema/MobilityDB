  interp(tpcpatch(pcpatch(pcpoint(1, 1, 1, 1),
  pcpoint(1, 2, 2, 2)), tstzspanset '{[2001-01-01, 2001-01-02], [2001-01-03, 2001-01-04]}'));
 tempsubtype | interp 
