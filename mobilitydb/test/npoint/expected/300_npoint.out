-------------------------------------------------------------------------------
-- Input
-------------------------------------------------------------------------------
SELECT npoint 'npoint(1,0.5)';
    npoint     
---------------
 NPoint(1,0.5)
(1 row)

SELECT npoint ' npoint   (   1   ,	0.5   )   ';
    npoint     
---------------
 NPoint(1,0.5)
(1 row)

-- An SRID is read when it is the one of the network
SELECT asEWKT(npoint 'SRID=5676;npoint(1,0.5)');
         asewkt          
-------------------------
 SRID=5676;NPoint(1,0.5)
(1 row)

/* Errors */
SELECT npoint 'point(1,0.5)';
ERROR:  Could not parse npoint value: Missing prefix 'NPoint'
LINE 2: SELECT npoint 'point(1,0.5)';
                      ^
SELECT npoint 'npoint 1,0.5)';
ERROR:  Could not parse npoint value: Missing opening parenthesis
LINE 1: SELECT npoint 'npoint 1,0.5)';
                      ^
SELECT npoint 'npoint(1,0.5';
ERROR:  Missing delimeter character ')': 0.5
LINE 1: SELECT npoint 'npoint(1,0.5';
                      ^
SELECT npoint 'npoint(1 0.5)';
ERROR:  Missing delimeter character ',': 1 0.5)
LINE 1: SELECT npoint 'npoint(1 0.5)';
                      ^
SELECT npoint 'npoint(1000,0.5)';
ERROR:  There is no route with gid value 1000 in table ways
LINE 1: SELECT npoint 'npoint(1000,0.5)';
                      ^
SELECT npoint 'npoint(1,1.5)';
ERROR:  The relative position must be a real number between 0 and 1
LINE 1: SELECT npoint 'npoint(1,1.5)';
                      ^
SELECT npoint 'npoint(1,0.5)xxx';
ERROR:  Could not parse npoint value: Extraneous characters at the end
LINE 1: SELECT npoint 'npoint(1,0.5)xxx';
                      ^
-- An SRID other than the one of the network is refused
SELECT npoint 'SRID=4326;npoint(1,0.5)';
ERROR:  The SRID of the npoint (4326) does not match the SRID of the network (5676)
LINE 1: SELECT npoint 'SRID=4326;npoint(1,0.5)';
                      ^
SELECT npointFromEWKT('SRID=4326;Npoint(1,0.5)');
ERROR:  The SRID of the npoint (4326) does not match the SRID of the network (5676)
SELECT nsegment 'nsegment(1,0.5,0.7)';
      nsegment       
---------------------
 NSegment(1,0.5,0.7)
(1 row)

SELECT nsegment '  nsegment  (  1  ,  0.5  ,  0.7 ) ';
      nsegment       
---------------------
 NSegment(1,0.5,0.7)
(1 row)

-- An SRID is read when it is the one of the network
SELECT nsegment 'SRID=5676;nsegment(1,0.5,0.7)';
      nsegment       
---------------------
 NSegment(1,0.5,0.7)
(1 row)

/* Errors */
SELECT nsegment 'Nsegment 1, 1.1)';
ERROR:  Could not parse nsegment value: Missing opening parenthesis
LINE 2: SELECT nsegment 'Nsegment 1, 1.1)';
                        ^
SELECT nsegment(1, 1.1);
ERROR:  The relative position must be a real number between 0 and 1
SELECT nsegment 'segment(1,0.5,0.7)';
ERROR:  Could not parse nsegment value: Missing prefix 'NSegment'
LINE 1: SELECT nsegment 'segment(1,0.5,0.7)';
                        ^
SELECT nsegment 'nsegment(1,0.5,0.7';
ERROR:  Missing delimeter character ')': 0.7
LINE 1: SELECT nsegment 'nsegment(1,0.5,0.7';
                        ^
SELECT nsegment 'nsegment(1 0.5 0.7)';
ERROR:  Missing delimeter character ',': 1 0.5 0.7)
LINE 1: SELECT nsegment 'nsegment(1 0.5 0.7)';
                        ^
SELECT nsegment 'nsegment(1000,0.5,0.7)';
ERROR:  There is no route with gid value 1000 in table ways
LINE 1: SELECT nsegment 'nsegment(1000,0.5,0.7)';
                        ^
SELECT nsegment 'nsegment(1,1.5,0.7)';
ERROR:  The relative position must be a real number between 0 and 1
LINE 1: SELECT nsegment 'nsegment(1,1.5,0.7)';
                        ^
SELECT nsegment 'nsegment(1,0.5,0.7)xxx';
ERROR:  Could not parse nsegment value: Extraneous characters at the end
LINE 1: SELECT nsegment 'nsegment(1,0.5,0.7)xxx';
                        ^
SELECT nsegment 'NSegment(1, 1, 1.5)';
ERROR:  The relative position must be a real number between 0 and 1
LINE 1: SELECT nsegment 'NSegment(1, 1, 1.5)';
                        ^
-- An SRID other than the one of the network is refused
SELECT nsegment 'SRID=4326;nsegment(1,0.5,0.7)';
ERROR:  The SRID of the nsegment (4326) does not match the SRID of the network (5676)
LINE 1: SELECT nsegment 'SRID=4326;nsegment(1,0.5,0.7)';
                        ^
-------------------------------------------------------------------------------
-- Input/output in (E)WKT, (E)WKB, and HexWKB representation
-------------------------------------------------------------------------------
SELECT asText(npoint 'SRID=5676;Npoint(1,0.5)');
    astext     
---------------
 NPoint(1,0.5)
(1 row)

SELECT asEWKT(npoint 'SRID=5676;Npoint(1,0.5)');
         asewkt          
-------------------------
 SRID=5676;NPoint(1,0.5)
(1 row)

SELECT asBinary(npoint 'SRID=5676;Npoint(1,0.5)');
                asbinary                
----------------------------------------
 \x01010100000000000000000000000000e03f
(1 row)

SELECT asEWKB(npoint 'SRID=5676;Npoint(1,0.5)');
                     asewkb                     
------------------------------------------------
 \x01412c1600000100000000000000000000000000e03f
(1 row)

SELECT asHexWKB(npoint 'SRID=5676;Npoint(1,0.5)');
               ashexwkb               
--------------------------------------
 01010100000000000000000000000000E03F
(1 row)

SELECT asHexEWKB(npoint 'SRID=5676;Npoint(1,0.5)');
                  ashexewkb                   
----------------------------------------------
 01412C1600000100000000000000000000000000E03F
(1 row)

SELECT npointFromText(asText(npoint 'SRID=5676;Npoint(1,0.5)'));
 npointfromtext 
----------------
 NPoint(1,0.5)
(1 row)

SELECT npointFromEWKT(asEWKT(npoint 'SRID=5676;Npoint(1,0.5)'));
 npointfromewkt 
----------------
 NPoint(1,0.5)
(1 row)

SELECT npointFromBinary(asBinary(npoint 'SRID=5676;Npoint(1,0.5)'));
 npointfrombinary 
------------------
 NPoint(1,0.5)
(1 row)

SELECT npointFromEWKB(asEWKB(npoint 'SRID=5676;Npoint(1,0.5)'));
 npointfromewkb 
----------------
 NPoint(1,0.5)
(1 row)

SELECT npointFromHexEWKB(asHexWKB(npoint 'SRID=5676;Npoint(1,0.5)'));
 npointfromhexewkb 
-------------------
 NPoint(1,0.5)
(1 row)

SELECT npointFromHexWKB(asHexWKB(npoint 'SRID=5676;Npoint(1,0.5)'));
 npointfromhexwkb 
------------------
 NPoint(1,0.5)
(1 row)

SELECT npointFromHexEWKB(asHexEWKB(npoint 'SRID=5676;Npoint(1,0.5)'));
 npointfromhexewkb 
-------------------
 NPoint(1,0.5)
(1 row)

-- An SRID other than the one of the network is refused
SELECT npointFromHexEWKB(replace(asHexEWKB(npoint 'SRID=5676;Npoint(1,0.5)', 'XDR'), '0000162C', '000010E6'));
ERROR:  The SRID of the WKB (4326) does not match the SRID of the network (5676)
SELECT asBinary(nsegment 'NSegment(1,0.5,0.7)');
                        asbinary                        
--------------------------------------------------------
 \x01010100000000000000000000000000e03f666666666666e63f
(1 row)

SELECT asEWKB(nsegment 'NSegment(1,0.5,0.7)');
                             asewkb                             
----------------------------------------------------------------
 \x01412c1600000100000000000000000000000000e03f666666666666e63f
(1 row)

SELECT asHexWKB(nsegment 'NSegment(1,0.5,0.7)');
                       ashexwkb                       
------------------------------------------------------
 01010100000000000000000000000000E03F666666666666E63F
(1 row)

SELECT asHexEWKB(nsegment 'NSegment(1,0.5,0.7)');
                          ashexewkb                           
--------------------------------------------------------------
 01412C1600000100000000000000000000000000E03F666666666666E63F
(1 row)

SELECT asHexEWKB(nsegment 'NSegment(1,0.5,0.7)', 'XDR');
                          ashexewkb                           
--------------------------------------------------------------
 00410000162C00000000000000013FE00000000000003FE6666666666666
(1 row)

SELECT nsegmentFromBinary(asBinary(nsegment 'NSegment(1,0.5,0.7)'));
 nsegmentfrombinary  
---------------------
 NSegment(1,0.5,0.7)
(1 row)

SELECT nsegmentFromEWKB(asEWKB(nsegment 'NSegment(1,0.5,0.7)', 'XDR'));
  nsegmentfromewkb   
---------------------
 NSegment(1,0.5,0.7)
(1 row)

SELECT nsegmentFromHexWKB(asHexWKB(nsegment 'NSegment(1,0.5,0.7)'));
 nsegmentfromhexwkb  
---------------------
 NSegment(1,0.5,0.7)
(1 row)

SELECT nsegmentFromHexEWKB(asHexEWKB(nsegment 'NSegment(1,0.5,0.7)'));
 nsegmentfromhexewkb 
---------------------
 NSegment(1,0.5,0.7)
(1 row)

-- An SRID other than the one of the network is refused, and so is a route the
-- network lacks
SELECT nsegmentFromHexEWKB(replace(asHexEWKB(nsegment 'NSegment(1,0.5,0.7)', 'XDR'), '0000162C', '000010E6'));
ERROR:  The SRID of the WKB (4326) does not match the SRID of the network (5676)
SELECT nsegmentFromHexWKB(replace(asHexWKB(nsegment 'NSegment(1,0.5,0.7)', 'XDR'), '0000000000000001', '00000000000003E8'));
ERROR:  There is no route with gid value 1000 in table ways
SELECT asText(nsegment 'NSegment(1,0.5,0.7)');
       astext        
---------------------
 NSegment(1,0.5,0.7)
(1 row)

SELECT asText(nsegment 'NSegment(1,0.123456,0.7)', 2);
        astext        
----------------------
 NSegment(1,0.12,0.7)
(1 row)

SELECT asEWKT(nsegment 'NSegment(1,0.5,0.7)');
            asewkt             
-------------------------------
 SRID=5676;NSegment(1,0.5,0.7)
(1 row)

SELECT nsegmentFromText(asText(nsegment 'NSegment(1,0.5,0.7)'))
       = nsegment 'NSegment(1,0.5,0.7)';
 ?column? 
----------
 t
(1 row)

SELECT nsegmentFromEWKT(asEWKT(nsegment 'NSegment(1,0.5,0.7)'))
       = nsegment 'NSegment(1,0.5,0.7)';
 ?column? 
----------
 t
(1 row)

/* Errors */
SELECT nsegmentFromEWKT('SRID=4326;NSegment(1,0.5,0.7)');
ERROR:  The SRID of the nsegment (4326) does not match the SRID of the network (5676)
-------------------------------------------------------------------------------
-- Constructors
-------------------------------------------------------------------------------
SELECT npoint(1, 0.5);
    npoint     
---------------
 NPoint(1,0.5)
(1 row)

/* Errors */
SELECT npoint(1000,0.5);
ERROR:  There is no route with gid value 1000 in table ways
SELECT npoint(1,1.5);
ERROR:  The relative position must be a real number between 0 and 1
SELECT nsegment(1, 0.2, 0.6);
      nsegment       
---------------------
 NSegment(1,0.2,0.6)
(1 row)

SELECT nsegment(1);
    nsegment     
-----------------
 NSegment(1,0,1)
(1 row)

SELECT nsegment(1, 0.2);
     nsegment      
-------------------
 NSegment(1,0.2,1)
(1 row)

SELECT nsegment(npoint(1, 0.5));
      nsegment       
---------------------
 NSegment(1,0.5,0.5)
(1 row)

/* Errors */
SELECT nsegment(1000,0.5,0.7);
ERROR:  There is no route with gid value 1000 in table ways
SELECT nsegment(1,1.5,0.7);
ERROR:  The relative position must be a real number between 0 and 1
